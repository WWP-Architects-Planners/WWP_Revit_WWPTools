<!--
  Shared visual language for every WWPTools dialog, matched to the Landscape Data Manager (LIM)
  tools: a calm Fluent look with a light grey page, white cards with soft 1px borders and 10px
  corners, one restrained teal accent, quiet typography, and data tables drawn as pale
  "swim lanes" of related columns.

  This file is the canonical owner. WWPTools.extension/lib/FlatTheme.xaml must stay a
  byte-for-byte mirror (tools/verify_ui_assets.py checks it): the compiled views merge this
  copy, the pyRevit dialogs load the mirror into Application.Resources via WWP_uiUtils.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ COLOR TOKENS -->
    <!-- Surfaces and text -->
    <SolidColorBrush x:Key="WindowBrush"        Color="#F3F3F3" />  <!-- page -->
    <SolidColorBrush x:Key="PanelBrush"         Color="#FFFFFF" />  <!-- card -->
    <SolidColorBrush x:Key="SurfaceBrush"       Color="#F7F7F7" />  <!-- subtle fill: read-only, inset -->
    <SolidColorBrush x:Key="BorderBrush"        Color="#E0E0E0" />  <!-- card / control stroke -->
    <SolidColorBrush x:Key="StrongBorderBrush"  Color="#8A8A8A" />  <!-- input underline, check box -->
    <SolidColorBrush x:Key="TextBrush"          Color="#1B1B1B" />
    <SolidColorBrush x:Key="MutedBrush"         Color="#616161" />
    <SolidColorBrush x:Key="HoverBrush"         Color="#F0F0F0" />  <!-- neutral pointer-over -->
    <SolidColorBrush x:Key="PressedBrush"       Color="#E6E6E6" />

    <!-- Accent: LIM teal. AccentBrush carries white text (4.8:1); AccentBrightBrush is for marks only. -->
    <SolidColorBrush x:Key="AccentBrush"        Color="#007F7F" />
    <SolidColorBrush x:Key="AccentHoverBrush"   Color="#006B6B" />
    <SolidColorBrush x:Key="AccentPressBrush"   Color="#005858" />
    <SolidColorBrush x:Key="AccentBrightBrush"  Color="#00A6A6" />
    <SolidColorBrush x:Key="AccentSoftBrush"    Color="#E6F2F2" />
    <SolidColorBrush x:Key="SelectedBrush"      Color="#D7EDED" />

    <!-- Status. Always paired with text, never colour alone. -->
    <SolidColorBrush x:Key="SuccessBrush"       Color="#1A7F37" />
    <SolidColorBrush x:Key="SuccessSoftBrush"   Color="#EAF5EC" />
    <SolidColorBrush x:Key="WarningBrush"       Color="#9D5300" />
    <SolidColorBrush x:Key="WarningSoftBrush"   Color="#FBF1E5" />
    <SolidColorBrush x:Key="DangerBrush"        Color="#C4262E" />
    <SolidColorBrush x:Key="DangerHoverBrush"   Color="#A81F27" />
    <SolidColorBrush x:Key="DangerPressBrush"   Color="#8E1A21" />
    <SolidColorBrush x:Key="DangerSoftBrush"    Color="#FBEAEA" />
    <SolidColorBrush x:Key="InfoBrush"          Color="#007F7F" />
    <SolidColorBrush x:Key="InfoSoftBrush"      Color="#E6F2F2" />
    <SolidColorBrush x:Key="NeutralBrush"       Color="#616161" />
    <SolidColorBrush x:Key="OverlayBrush"       Color="#661B1B1B" />

    <!-- Swim lanes: pale washes behind groups of related table columns (results, inputs, ...),
         each with a matching text colour for the lane's CAPS label and headers. -->
    <SolidColorBrush x:Key="LaneGreenBrush"      Color="#16176B2B" />
    <SolidColorBrush x:Key="LaneBlueBrush"       Color="#162F6FB0" />
    <SolidColorBrush x:Key="LaneAmberBrush"      Color="#1AA36A00" />
    <SolidColorBrush x:Key="LaneGreyBrush"       Color="#12586359" />
    <SolidColorBrush x:Key="LaneVioletBrush"     Color="#166B4FA0" />
    <SolidColorBrush x:Key="LaneTealBrush"       Color="#16007A70" />
    <SolidColorBrush x:Key="LaneGreenTextBrush"  Color="#176B2B" />
    <SolidColorBrush x:Key="LaneBlueTextBrush"   Color="#2F6FB0" />
    <SolidColorBrush x:Key="LaneAmberTextBrush"  Color="#A36A00" />
    <SolidColorBrush x:Key="LaneGreyTextBrush"   Color="#586359" />
    <SolidColorBrush x:Key="LaneVioletTextBrush" Color="#6B4FA0" />
    <SolidColorBrush x:Key="LaneTealTextBrush"   Color="#00756B" />
    <SolidColorBrush x:Key="TableDividerBrush"   Color="#DDE4DA" />

    <!-- WWPTools ribbon/brand palette -->
    <SolidColorBrush x:Key="BrandSetupBrush"   Color="#3A449A" />
    <SolidColorBrush x:Key="BrandContextBrush" Color="#2B8AC7" />
    <SolidColorBrush x:Key="BrandManageBrush"  Color="#6AA747" />
    <SolidColorBrush x:Key="BrandSheetsBrush"  Color="#ED691F" />
    <SolidColorBrush x:Key="BrandCleanupBrush" Color="#54565A" />
    <SolidColorBrush x:Key="BrandCueBrush"     Color="#FFDD47" />

    <!-- Fluent control strokes: a light frame whose bottom edge is darker. The brush maps a
         2px band and is flipped so the band lands on the bottom edge whatever the height. -->
    <LinearGradientBrush x:Key="InputStrokeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5" />
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#8A8A8A" />
        <GradientStop Offset="1.0" Color="#E0E0E0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ControlStrokeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5" />
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="#C9C9C9" />
        <GradientStop Offset="1.0" Color="#E0E0E0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentStrokeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5" />
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="#005858" />
        <GradientStop Offset="1.0" Color="#007F7F" />
    </LinearGradientBrush>

    <!-- Spacing shared by every window so the dialogs read as one family. -->
    <Thickness x:Key="PageMargin">24,20,24,20</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>

    <!-- ═════════════════════════════════════════════════════════════ WINDOW -->
    <Style TargetType="Window">
        <Setter Property="Background"        Value="{StaticResource WindowBrush}" />
        <Setter Property="FontFamily"        Value="Segoe UI Variable, Segoe UI" />
        <Setter Property="FontSize"          Value="13.5" />
        <Setter Property="Foreground"        Value="{StaticResource TextBrush}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <!-- ═════════════════════════════════════════════════════════ CARDS -->
    <!-- Card: the one container for a grouped section (white, 1px border, 10px corners). -->
    <Style x:Key="WwpCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style x:Key="WwpWindowFrame" TargetType="Border" BasedOn="{StaticResource WwpCard}" />
    <!-- Compact card for a stat tile or a small inset group. -->
    <Style x:Key="WwpCardSurface" TargetType="Border" BasedOn="{StaticResource WwpCard}">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <!-- Inset well inside a card, e.g. an options block or a read-only summary. -->
    <Style x:Key="WwpInset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <!-- Footer bar under the cards: logo left, actions right. -->
    <Style x:Key="WwpFooter" TargetType="DockPanel">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="LastChildFill" Value="False" />
    </Style>

    <!-- ══════════════════════════════════════════════════════ TYPOGRAPHY -->
    <!-- One clear hierarchy instead of ad-hoc FontSize/FontWeight per dialog. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <!-- Section header inside a card (LIM: 13 SemiBold, muted). -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="WwpSectionHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionHeader}" />
    <!-- Label above (or beside) a single input. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
        <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Big number in a stat tile. -->
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ══════════════════════════════════════════ DATA TABLES (swim lanes) -->
    <!-- One table language in every tool. Columns that belong together sit in a vertical swim
         lane: a pale wash behind the header and every row, with the lane's name in CAPS above.
         Each header is its name on top and unit/qualifier below (Text="Area&#x0a;m2"),
         bottom-aligned, so cells hold plain values; numbers are right-aligned.

         Hand-built tables (Grid rows): the lane layer, the lane-label row, the header row and
         every row repeat one set of ColumnDefinitions; lanes are TableLane borders spanning
         their columns in the lane layer. DataGrids: give a column LaneXxxHeader + LaneXxxCell
         (header and cells then share the wash), and TableNumberText as its ElementStyle. -->
    <Style x:Key="TableLane" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Margin" Value="-4,0" />
    </Style>
    <Style x:Key="TableGroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource LaneGreyTextBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="TableHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource LaneGreyTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="LineHeight" Value="15" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TableNumberHeader" TargetType="TextBlock" BasedOn="{StaticResource TableHeader}">
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <!-- A hand-built table row: divider on top, LIM row padding. -->
    <Style x:Key="TableRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource TableDividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="TableCellText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="TableNumberText" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════ SEPARATOR -->
    <Style TargetType="Separator">
        <Setter Property="Background"      Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height"          Value="1" />
        <Setter Property="Margin"          Value="0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════ TOOLTIP -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding"    Value="9,6" />
        <Setter Property="FontSize"   Value="12" />
        <Setter Property="MaxWidth"   Value="420" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="6"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2"
                                              Color="#000000" Opacity="0.14" />
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════ CONTEXT MENU -->
    <!-- Keyed, one-level menu for a toolbar overflow button. Not implicit, so menus with
         submenus elsewhere keep the system template. Items pick up WwpMenuItem. -->
    <Style x:Key="WwpMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Height"     Value="32" />
        <Setter Property="Padding"    Value="12,0,16,0" />
        <Setter Property="Cursor"     Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="WwpContextMenu" TargetType="ContextMenu">
        <Setter Property="Background"         Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush"        Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding"            Value="4" />
        <Setter Property="HasDropShadow"      Value="False" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource WwpMenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="6"
                            MinWidth="190"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2"
                                              Color="#000000" Opacity="0.14" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════ TEXTBOX -->
    <Style TargetType="TextBox">
        <Setter Property="Background"               Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground"               Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush"              Value="{StaticResource InputStrokeBrush}" />
        <Setter Property="BorderThickness"          Value="1" />
        <Setter Property="Padding"                  Value="9,6" />
        <Setter Property="MinHeight"                Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush"               Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush"           Value="{StaticResource AccentBrightBrush}" />
        <Setter Property="FocusVisualStyle"         Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <!-- No Margin here: TextBoxBase already applies Padding to its
                                 content host, binding it again doubled the inset. -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <!-- Focus: the Fluent 2px accent underline. -->
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom"
                                Margin="1,0" CornerRadius="0,0,3,3"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FAFAFA" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBrush}" />
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="Foreground" Value="#9E9E9E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox shares the TextBox geometry. -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background"               Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush"              Value="{StaticResource InputStrokeBrush}" />
        <Setter Property="BorderThickness"          Value="1" />
        <Setter Property="Padding"                  Value="9,6" />
        <Setter Property="MinHeight"                Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle"         Value="{x:Null}" />
    </Style>

    <!-- ═══════════════════════════════════════════ COMBOBOX TOGGLE BUTTON -->
    <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4.5 4.5 L 9 0"
                      Stroke="{StaticResource MutedBrush}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Fill="Transparent" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F6F6F6" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F3F3F3" />
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource TextBrush}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ═════════════════════════════════════════════════════════ COMBOBOX -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"               Value="#FBFBFB" />
        <Setter Property="Foreground"               Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush"              Value="{StaticResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness"          Value="1" />
        <Setter Property="MinHeight"                Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle"         Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press" />
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,32,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalAlignment="Left" />
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Hidden"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Margin="8,0,32,0"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 BorderThickness="0"
                                 MinHeight="0"
                                 Padding="0"
                                 Style="{x:Null}"
                                 FocusVisualStyle="{x:Null}" />
                        <Border x:Name="FocusLine" Height="2" VerticalAlignment="Bottom"
                                Margin="1,0" CornerRadius="0,0,3,3"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed"
                                IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border x:Name="DropDown"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,8,10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="4"
                                                      Color="#000000" Opacity="0.12" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True" Margin="4">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite"          Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEditable" Value="True" />
                                <Condition Property="IsKeyboardFocusWithin" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="FocusLine" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ToggleButton" Property="Opacity" Value="0.55" />
                            <Setter Property="Foreground" Value="#9E9E9E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding"          Value="10,6" />
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Pill" Width="3" Height="14" CornerRadius="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#9E9E9E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════ LISTBOX -->
    <Style TargetType="ListBox">
        <Setter Property="Background"       Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Padding"          Value="4" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBoxItem: neutral hover, pale-teal selection with the Fluent accent pill. -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding"                    Value="10,6" />
        <Setter Property="Margin"                     Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle"           Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListViewItem -->
    <Style TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding"                    Value="4,4" />
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="BorderThickness"            Value="0" />
        <Setter Property="FocusVisualStyle"           Value="{x:Null}" />
        <!-- GridView rows get table dividers; plain ListViews (no GridView) swap to the
             content template in Style.Triggers below. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource TableDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter x:Name="RowPresenter"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                              Content="{TemplateBinding Content}"
                                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- GridView headers in the table language: quiet, SemiBold, bottom divider. -->
    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background"                 Value="Transparent" />
        <Setter Property="Foreground"                 Value="{StaticResource LaneGreyTextBrush}" />
        <Setter Property="FontSize"                   Value="12" />
        <Setter Property="FontWeight"                 Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment"   Value="Bottom" />
        <Setter Property="Padding"                    Value="8,6,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource TableDividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8"
                               Margin="0,0,-4,0" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════ BUTTONS -->
    <!-- Exactly one primary (accent) action per dialog; everything else is the plain default
         button. The default Button style is therefore the neutral Fluent button. -->
    <Style TargetType="Button">
        <Setter Property="Background"       Value="#FBFBFB" />
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush"      Value="{StaticResource ControlStrokeBrush}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Height"           Value="32" />
        <Setter Property="Padding"          Value="14,0" />
        <Setter Property="FontWeight"       Value="Normal" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F5F5F5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EFEFEF" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary = the default button, named for dialogs that set it explicitly. -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />

    <!-- Primary: the single accent action (Export, Run, OK, Apply). -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background"       Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground"       Value="White" />
        <Setter Property="BorderBrush"      Value="{StaticResource AccentStrokeBrush}" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Height"           Value="32" />
        <Setter Property="Padding"          Value="18,0" />
        <Setter Property="FontWeight"       Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}" />

    <!-- Outline: transparent fill with a plain stroke, for toolbar-style actions on a card. -->
    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <!-- Ghost: no fill or stroke until hovered. Row actions, inline links. -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush"      Value="Transparent" />
        <Setter Property="BorderThickness"  Value="1" />
        <Setter Property="Height"           Value="32" />
        <Setter Property="Padding"          Value="10,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only square ghost button (Segoe MDL2 glyph content). Set ToolTip + AutomationProperties.Name. -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Width"      Value="32" />
        <Setter Property="Padding"    Value="0" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize"   Value="14" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <!-- Add row: the accent "+ Add ..." line under the last row of a hand-built table. -->
    <Style x:Key="AddRowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground"                 Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight"                 Value="SemiBold" />
        <Setter Property="Height"                     Value="36" />
        <Setter Property="Padding"                    Value="8,0,14,0" />
        <Setter Property="HorizontalAlignment"        Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Destructive: red fill for the one irreversible action (Delete N items). -->
    <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background"  Value="{StaticResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource DangerHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"  Value="{StaticResource DangerPressBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerPressBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════ CHECKBOX -->
    <Style TargetType="CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground"        Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle"  Value="{x:Null}" />
        <Setter Property="Cursor"            Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="4"
                                BorderBrush="{StaticResource StrongBorderBrush}"
                                BorderThickness="1"
                                Background="#FBFBFB"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Check"
                                  Visibility="Collapsed"
                                  Width="10" Height="8"
                                  Stretch="Uniform"
                                  Stroke="White"
                                  StrokeThickness="1.8"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0 3.5 L 3.5 7 L 9 0" />
                        </Border>
                        <ContentPresenter x:Name="Label"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#F3F3F3" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box"   Property="Background"  Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box"   Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility"  Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box"   Property="Background"  Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box"   Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility"  Value="Visible" />
                            <Setter TargetName="Check" Property="Data"        Value="M 0 0 L 8 0" />
                            <Setter TargetName="Check" Property="Height"      Value="2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Box" Property="Opacity" Value="0.45" />
                            <Setter Property="Foreground" Value="#9E9E9E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fluent toggle switch, for on/off options (a CheckBox or ToggleButton). -->
    <ControlTemplate x:Key="ToggleSwitchTemplate" TargetType="ToggleButton">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
            <Grid Width="40" Height="20">
                <Border x:Name="Track"
                        CornerRadius="10"
                        Background="#FBFBFB"
                        BorderBrush="{StaticResource StrongBorderBrush}"
                        BorderThickness="1" />
                <Ellipse x:Name="Thumb"
                         Width="12" Height="12"
                         Fill="#5C5C5C"
                         HorizontalAlignment="Left"
                         Margin="4,0,0,0" />
            </Grid>
            <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#F0F0F0" />
                <Setter TargetName="Thumb" Property="Width" Value="14" />
                <Setter TargetName="Thumb" Property="Height" Value="14" />
                <Setter TargetName="Thumb" Property="Margin" Value="3,0,0,0" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background"  Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrightBrush}" />
                <Setter TargetName="Track" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                <Setter Property="Foreground" Value="#9E9E9E" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template"         Value="{StaticResource ToggleSwitchTemplate}" />
    </Style>
    <Style x:Key="FlatToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleSwitch}" />
    <Style x:Key="ToggleSwitchCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground"       Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template"         Value="{StaticResource ToggleSwitchTemplate}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════ RADIOBUTTON -->
    <Style TargetType="RadioButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground"        Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle"  Value="{x:Null}" />
        <Setter Property="Cursor"            Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                        <Grid Width="18" Height="18">
                            <Ellipse x:Name="Ring"
                                     Fill="#FBFBFB"
                                     Stroke="{StaticResource StrongBorderBrush}"
                                     StrokeThickness="1" />
                            <Ellipse x:Name="Dot"
                                     Width="8" Height="8"
                                     Fill="White"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="Label"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="#F3F3F3" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill"   Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Dot"  Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrightBrush}" />
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            <Setter Property="Foreground" Value="#9E9E9E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ GROUPBOX: titled card -->
    <Style TargetType="GroupBox">
        <Setter Property="Margin"  Value="0,0,0,12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                          ContentSource="Header"
                                          Margin="2,0,0,6"
                                          TextElement.FontSize="13"
                                          TextElement.FontWeight="SemiBold"
                                          TextElement.Foreground="{StaticResource MutedBrush}"
                                          RecognizesAccessKey="True" />
                        <Border Grid.Row="1"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════ TABCONTROL / TABITEM -->
    <Style TargetType="TabControl">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0,12,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Background="Transparent"
                                      KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Border Grid.Row="1" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Foreground"       Value="{StaticResource MutedBrush}" />
        <Setter Property="Padding"          Value="12,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor"           Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Background="Transparent" Margin="0,0,4,0">
                        <Border x:Name="Bd" CornerRadius="6,6,0,0" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="Pill" Height="3" CornerRadius="1.5" Width="16"
                                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═════════════════════════════════════════════════════════ PROGRESSBAR -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height"     Value="4" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="2" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════ DATAGRID: the table language -->
    <!-- No zebra striping and no vertical rules: rows are separated by a quiet divider, headers
         are SemiBold lane-grey text on a white band, and column groups get lane washes. -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground"               Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness"          Value="1" />
        <Setter Property="RowBackground"            Value="{StaticResource PanelBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource PanelBrush}" />
        <Setter Property="GridLinesVisibility"      Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TableDividerBrush}" />
        <Setter Property="VerticalGridLinesBrush"   Value="{StaticResource TableDividerBrush}" />
        <Setter Property="HeadersVisibility"        Value="Column" />
        <Setter Property="RowHeaderWidth"           Value="0" />
        <Setter Property="CanUserResizeRows"        Value="False" />
        <Setter Property="SelectionMode"            Value="Single" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"                 Value="{StaticResource PanelBrush}" />
        <Setter Property="Foreground"                 Value="{StaticResource LaneGreyTextBrush}" />
        <Setter Property="BorderBrush"                Value="{StaticResource TableDividerBrush}" />
        <Setter Property="BorderThickness"            Value="0,0,0,1" />
        <Setter Property="Padding"                    Value="8,8,8,7" />
        <Setter Property="FontWeight"                 Value="SemiBold" />
        <Setter Property="FontSize"                   Value="12" />
        <Setter Property="VerticalContentAlignment"   Value="Bottom" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                                <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,0,4"
                                      VerticalAlignment="Bottom" Visibility="Collapsed"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 0 0 L 3.5 3.5 L 7 0" />
                            </Grid>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0 3.5 L 3.5 0 L 7 3.5" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background"      Value="{StaticResource PanelBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F7F7F7" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness"  Value="0" />
        <Setter Property="Background"       Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="8,5"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Right-aligned number column header (pair with TableNumberText as the ElementStyle). -->
    <Style x:Key="NumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- Swim-lane columns: header and cells share the lane wash; the header text takes the lane colour. -->
    <Style x:Key="LaneGreenHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource LaneGreenBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LaneGreenTextBrush}" />
    </Style>
    <Style x:Key="LaneBlueHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource LaneBlueBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LaneBlueTextBrush}" />
    </Style>
    <Style x:Key="LaneAmberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource LaneAmberBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LaneAmberTextBrush}" />
    </Style>
    <Style x:Key="LaneGreyHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource LaneGreyBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LaneGreyTextBrush}" />
    </Style>
    <Style x:Key="LaneVioletHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource LaneVioletBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LaneVioletTextBrush}" />
    </Style>
    <Style x:Key="LaneTealHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource LaneTealBrush}" />
        <Setter Property="Foreground" Value="{StaticResource LaneTealTextBrush}" />
    </Style>
    <Style x:Key="LaneGreenNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LaneGreenHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="LaneBlueNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LaneBlueHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="LaneAmberNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LaneAmberHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="LaneVioletNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LaneVioletHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>
    <Style x:Key="LaneTealNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LaneTealHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <Style x:Key="LaneGreenCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource LaneGreenBrush}" />
    </Style>
    <Style x:Key="LaneBlueCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource LaneBlueBrush}" />
    </Style>
    <Style x:Key="LaneAmberCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource LaneAmberBrush}" />
    </Style>
    <Style x:Key="LaneGreyCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource LaneGreyBrush}" />
    </Style>
    <Style x:Key="LaneVioletCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource LaneVioletBrush}" />
    </Style>
    <Style x:Key="LaneTealCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource LaneTealBrush}" />
    </Style>

    <!-- 6px white spacer column between two lanes (a DataGridTemplateColumn Width="6"). -->
    <Style x:Key="LaneGapHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="LaneGapCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- ═════════════════════════════════════════════ SCROLLBAR (LIM-style) -->
    <!-- A persistent rounded handle with a 14px drag target. -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth"  Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="#A3A3A3"
                            CornerRadius="4"
                            Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#7A7A7A" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#5C5C5C" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarPageButtonStyle" TargetType="RepeatButton">
        <Setter Property="IsTabStop"  Value="False" />
        <Setter Property="Focusable"  Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="Transparent" Width="14">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="True"
                   Width="14"
                   HorizontalAlignment="Center">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" Width="14" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Border Background="Transparent" Height="14">
            <Track x:Name="PART_Track"
                   IsDirectionReversed="False"
                   Height="14"
                   VerticalAlignment="Center">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumbStyle}" Height="14" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Style="{StaticResource ScrollBarPageButtonStyle}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width"    Value="14" />
                <Setter Property="MinWidth" Value="14" />
                <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="14" />
                <Setter Property="MinHeight" Value="14" />
                <Setter Property="Template"  Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════════════ BRAND IMAGES -->
    <!-- The PNG itself supplies transparent outer pixels. -->
    <Style x:Key="BrandLogoHero" TargetType="Image">
        <Setter Property="Width" Value="142" />
        <Setter Property="Height" Value="142" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="BrandLogoFooter" TargetType="Image">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="BrandLogoCompact" TargetType="Image">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

</ResourceDictionary>
