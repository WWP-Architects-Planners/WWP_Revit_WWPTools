<!--
  Fallback copy for WWP_uiUtils.uiUtils_area_keyplan_import, used only when the Import from Excel
  pushbutton's AreaKeyplanImportWindow.xaml is missing. Parsed after _ensure_theme().

  MappingGrid (LIM table language): Blue lane = the Excel source column, Green lane = the Revit
  parameter it maps to.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Area Key Schedule"
        Width="980"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Style="{StaticResource FieldLabel}"
                               Text="Excel File" />
                    <TextBox x:Name="FilePathBox"
                             Grid.Column="1"
                             MinWidth="420"
                             IsReadOnly="True" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="2"
                            Content="Browse"
                            MinWidth="88"
                            Margin="8,0,0,0" />
                    <Button x:Name="LoadButton"
                            Grid.Column="3"
                            Content="Load"
                            MinWidth="88"
                            Margin="8,0,0,0" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Style="{StaticResource FieldLabel}"
                               Text="Schedule Type" />
                    <ComboBox x:Name="TargetTypeCombo"
                              Grid.Column="1"
                              MinWidth="260" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource SectionHeader}"
                           Text="Map Excel columns to parameters" />

                <DataGrid x:Name="MappingGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          VirtualizingPanel.IsVirtualizing="False"
                          BorderThickness="0"
                          MinHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Excel Column"
                                            Binding="{Binding ColumnName}"
                                            IsReadOnly="True"
                                            HeaderStyle="{StaticResource LaneBlueHeader}"
                                            CellStyle="{StaticResource LaneBlueCell}"
                                            ElementStyle="{StaticResource TableCellText}"
                                            Width="2*" />
                        <DataGridTemplateColumn Width="6"
                                                HeaderStyle="{StaticResource LaneGapHeader}"
                                                CellStyle="{StaticResource LaneGapCell}"
                                                CanUserResize="False" />
                        <DataGridTemplateColumn Header="Map To"
                                                HeaderStyle="{StaticResource LaneGreenHeader}"
                                                CellStyle="{StaticResource LaneGreenCell}"
                                                Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center"
                   Style="{StaticResource BrandLogoFooter}" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="OkButton"
                        Content="OK"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="88"
                        IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
