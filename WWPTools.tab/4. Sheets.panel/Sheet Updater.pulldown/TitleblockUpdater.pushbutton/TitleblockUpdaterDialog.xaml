<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Titleblock Updater"
        Width="1120"
        Height="900"
        MinWidth="980"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <!-- Styles, brushes, tabs, list boxes and toggle switches all come from the shared
         FlatTheme (lib/FlatTheme.xaml), loaded by the script before this XAML is parsed. -->

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Titleblock Updater"
                       Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="PromptText"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1">

            <TabItem Header="True North">
                <!-- FontWeight: the selected TabItem is SemiBold and that inherits into its content. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FontWeight="Normal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource WwpCard}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Text="Angle parameters" Style="{StaticResource SectionHeader}" />
                                <TextBlock Grid.Column="2" Text="Visibility parameters" Style="{StaticResource SectionHeader}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Ctrl/Shift-click to select multiple targets."
                                           Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <CheckBox x:Name="TN_SetVisibilityCheckBox"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          Content="Update visibility controls"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Style="{StaticResource ToggleSwitchCheckBox}" />
                                <ListBox x:Name="TN_ParameterList"
                                         Grid.Row="2"
                                         Grid.Column="0"
                                         SelectionMode="Extended"
                                         Height="240" />
                                <ListBox x:Name="TN_VisibilityParamList"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         SelectionMode="Extended"
                                         Height="240" />
                                <CheckBox x:Name="TN_HideCheckBox"
                                          Grid.Row="3"
                                          Grid.Column="2"
                                          Content="Hide arrow for elevation, section, or 3D primary views"
                                          IsChecked="True"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource ToggleSwitchCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Sheets" Style="{StaticResource SectionHeader}" />

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TN_SearchBox" />
                                    <CheckBox x:Name="TN_AllSheetsCheckBox"
                                              Grid.Column="2"
                                              Content="All Sheets"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchCheckBox}" />
                                </Grid>

                                <ListBox x:Name="TN_SheetsList"
                                         Grid.Row="2"
                                         SelectionMode="Extended"
                                         MinHeight="220" />

                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="TN_AllSheetsWarningText"
                                               Text="To update individual sheets, uncheck 'All Sheets'."
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="TN_ValidationText"
                                               Foreground="{StaticResource DangerBrush}"
                                               Visibility="Collapsed"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Project North(Construction North)">
                <!-- FontWeight: the selected TabItem is SemiBold and that inherits into its content. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FontWeight="Normal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource WwpCard}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Text="Angle parameters" Style="{StaticResource SectionHeader}" />
                                <TextBlock Grid.Column="2" Text="Visibility parameters" Style="{StaticResource SectionHeader}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Ctrl/Shift-click to select multiple targets."
                                           Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <CheckBox x:Name="PN_SetVisibilityCheckBox"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          Content="Update visibility controls"
                                          IsChecked="True"
                                          Margin="0,0,0,8"
                                          Style="{StaticResource ToggleSwitchCheckBox}" />
                                <ListBox x:Name="PN_ParameterList"
                                         Grid.Row="2"
                                         Grid.Column="0"
                                         SelectionMode="Extended"
                                         Height="240" />
                                <ListBox x:Name="PN_VisibilityParamList"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         SelectionMode="Extended"
                                         Height="240" />
                                <CheckBox x:Name="PN_HideCheckBox"
                                          Grid.Row="3"
                                          Grid.Column="2"
                                          Content="Hide arrow for elevation, section, or 3D primary views"
                                          IsChecked="True"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource ToggleSwitchCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Sheets" Style="{StaticResource SectionHeader}" />

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PN_SearchBox" />
                                    <CheckBox x:Name="PN_AllSheetsCheckBox"
                                              Grid.Column="2"
                                              Content="All Sheets"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchCheckBox}" />
                                </Grid>

                                <ListBox x:Name="PN_SheetsList"
                                         Grid.Row="2"
                                         SelectionMode="Extended"
                                         MinHeight="220" />

                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="PN_AllSheetsWarningText"
                                               Text="To update individual sheets, uncheck 'All Sheets'."
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="PN_ValidationText"
                                               Foreground="{StaticResource DangerBrush}"
                                               Visibility="Collapsed"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Scale">
                <!-- FontWeight: the selected TabItem is SemiBold and that inherits into its content. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              FontWeight="Normal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource WwpCard}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Text="Target parameters" Style="{StaticResource SectionHeader}" />
                                <TextBlock Grid.Column="2" Text="Visibility parameters" Style="{StaticResource SectionHeader}" />
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Ctrl/Shift-click to select multiple targets."
                                           Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <CheckBox x:Name="SC_SetVisibilityCheckBox"
                                          Grid.Row="1"
                                          Grid.Column="2"
                                          Content="Update visibility controls"
                                          Margin="0,0,0,8"
                                          Style="{StaticResource ToggleSwitchCheckBox}" />
                                <ListBox x:Name="SC_ParameterList"
                                         Grid.Row="2"
                                         Grid.Column="0"
                                         SelectionMode="Extended"
                                         Height="240" />
                                <ListBox x:Name="SC_VisibilityParamList"
                                         Grid.Row="2"
                                         Grid.Column="2"
                                         SelectionMode="Extended"
                                         Height="240"
                                         IsEnabled="False" />
                                <CheckBox x:Name="SC_IgnoreDraftingViewsCheckBox"
                                          Grid.Row="3"
                                          Grid.Column="0"
                                          Content="Ignore Drafting Views when calculating sheet scale"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource ToggleSwitchCheckBox}" />
                                <CheckBox x:Name="SC_HideCheckBox"
                                          Grid.Row="3"
                                          Grid.Column="2"
                                          Content="Also hide (set to No) on sheets with no scaleable views"
                                          IsEnabled="False"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource ToggleSwitchCheckBox}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Sheets" Style="{StaticResource SectionHeader}" />

                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SC_SearchBox" />
                                    <CheckBox x:Name="SC_AllSheetsCheckBox"
                                              Grid.Column="2"
                                              Content="All Sheets"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitchCheckBox}" />
                                </Grid>

                                <ListBox x:Name="SC_SheetsList"
                                         Grid.Row="2"
                                         SelectionMode="Extended"
                                         MinHeight="220" />

                                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                                    <TextBlock x:Name="SC_AllSheetsWarningText"
                                               Text="To update individual sheets, uncheck 'All Sheets'."
                                               Style="{StaticResource CaptionText}" />
                                    <TextBlock x:Name="SC_ValidationText"
                                               Foreground="{StaticResource DangerBrush}"
                                               Visibility="Collapsed"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="GlobalValidationText"
                   Grid.Row="2"
                   Foreground="{StaticResource DangerBrush}"
                   Visibility="Collapsed"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="LogoImage"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left" />
            <CheckBox x:Name="RememberChoicesCheckBox"
                      Grid.Column="1"
                      Content="Remember my choices for this project"
                      IsChecked="True"
                      Margin="16,0"
                      VerticalAlignment="Center"
                      Style="{StaticResource ToggleSwitchCheckBox}" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button x:Name="OkButton"
                        Content="Update True North"
                        MinWidth="170"
                        Margin="0,0,8,0"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="110"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
