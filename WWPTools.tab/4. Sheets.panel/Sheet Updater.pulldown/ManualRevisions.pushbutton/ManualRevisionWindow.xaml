<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Rev updater"
        Width="1120"
        Height="800"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="HeaderTitle"
                       Style="{StaticResource PageTitle}"
                       Text="Manual Rev updater" />
            <TextBlock x:Name="SheetLabel"
                       Style="{StaticResource PageSubtitle}"
                       Text="Select sheets to update. The current sheet is shown first." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource WwpCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Style="{StaticResource SectionHeader}"
                                   Text="Parameter Mapping" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center" Text="Set 1 dates" />
                        <ComboBox x:Name="CmbLeftDatesParam" Grid.Row="1" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center" Text="Set 1 descriptions" />
                        <ComboBox x:Name="CmbLeftDescsParam" Grid.Row="2" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center" Text="Set 2 dates" />
                        <ComboBox x:Name="CmbRightDatesParam" Grid.Row="3" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center" Text="Set 2 descriptions" />
                        <ComboBox x:Name="CmbRightDescsParam" Grid.Row="4" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" VerticalAlignment="Center" Text="Set 3 dates" />
                        <ComboBox x:Name="CmbSet3DatesParam" Grid.Row="5" Grid.Column="1" Margin="8,0,0,8" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" Text="Set 3 descriptions" />
                        <ComboBox x:Name="CmbSet3DescsParam" Grid.Row="6" Grid.Column="1" Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource WwpCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="124" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0"
                                   Text="Target Titleblock" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,4,0,12"
                                   Style="{StaticResource CaptionText}"
                                   Text="Selected sheets always use the fake revision parameters on the target titleblock. Each selected sheet keeps its current titleblock as the source." />
                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,10" VerticalAlignment="Center" Text="Target titleblock" />
                        <ComboBox x:Name="CmbTargetTitleblock" Grid.Row="2" Grid.Column="1" Margin="8,0,0,10" />
                        <CheckBox x:Name="ChkIgnoreSingleColumn"
                                  Grid.Row="3"
                                  Grid.ColumnSpan="2"
                                  IsChecked="True">
                            <!-- The theme CheckBox lays its content out horizontally, so cap the width to let it wrap. -->
                            <TextBlock TextWrapping="Wrap"
                                       MaxWidth="270"
                                       Text="Ignore if revision table does not need two columns (10 lines or less)" />
                        </CheckBox>
                        <TextBlock x:Name="TxtMappingInfo"
                                   Margin="0,10,0,0"
                                   Grid.Row="4"
                                   Grid.ColumnSpan="2"
                                   Style="{StaticResource CaptionText}"
                                   Text="Select one or more sheets to update." />
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtHint"
                           Grid.Row="4"
                           Style="{StaticResource CaptionText}"
                           Text="Descriptions now wrap at about 34 characters without breaking words. Set 1 and Set 2 are required; Set 3 is optional for an extra revision column when needed." />
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="16"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Sheets to Update"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button x:Name="BtnSelectAll"
                                    MinWidth="90"
                                    Margin="0,0,8,0"
                                    Content="Select All" />
                            <Button x:Name="BtnClearSelection"
                                    MinWidth="90"
                                    Content="Clear" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="SheetsList"
                             Grid.Row="1"
                             SelectionMode="Extended"
                             MinHeight="260" />
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Style="{StaticResource WwpFooter}">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True" />
                <Button x:Name="BtnApply"
                        MinWidth="130"
                        Content="Update Sheets"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
