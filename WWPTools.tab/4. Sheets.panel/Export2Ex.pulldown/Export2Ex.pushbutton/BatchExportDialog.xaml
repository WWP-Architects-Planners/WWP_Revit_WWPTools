<!--
  Export2Ex - By Schedule: the main window. One row per saved export set.
  Export2ex-script.py (_show_batch_dialog) loads this file, clones SetRowTemplate once per set
  into RowsHost and wires every named control, so keep the x:Name values in step with it.
  There is no Save button: the script writes row edits to Project Information when the
  window closes.

  Table layout (LIM table language): the lane layer, the lane-label row, the header row and
  SetRowTemplate repeat the same ColumnDefinitions. Spacer columns stand in for column spacing;
  each lane spans its columns and overhangs by 4px, leaving a 6px gap between lanes.
    0 check | 1 set name | 2 sp | 3 schedule | 4 sp | 5 sheet | 6 sp | 7 output | 8 sp | 9 browse
    | 10 sp | 11 export | 12 sp | 13 delete
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Schedules"
        Width="1180" Height="620"
        MinWidth="900" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <DataTemplate x:Key="SetRowTemplate">
            <Border Style="{StaticResource TableRow}" Padding="8,6,8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="RowCheck" Grid.Column="0" IsChecked="True"
                              HorizontalAlignment="Left"
                              ToolTip="Include this set in Export selected"
                              AutomationProperties.Name="Include set" />
                    <TextBox x:Name="NameBox" Grid.Column="1"
                             ToolTip="Set name"
                             AutomationProperties.Name="Set name" />
                    <ComboBox x:Name="ScheduleCombo" Grid.Column="3"
                              IsEditable="True" IsTextSearchEnabled="False"
                              MaxDropDownHeight="320"
                              ToolTip="Type to filter the schedules in this model"
                              AutomationProperties.Name="Schedule" />
                    <TextBlock x:Name="SheetText" Grid.Column="5"
                               Style="{StaticResource TableCellText}"
                               AutomationProperties.Name="Sheet name" />
                    <TextBlock x:Name="PathText" Grid.Column="7"
                               Style="{StaticResource TableCellText}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="Output path" />
                    <Button x:Name="BrowseButton" Grid.Column="9"
                            Style="{StaticResource IconButton}"
                            Content="&#xED25;"
                            ToolTip="Choose the output file or folder"
                            AutomationProperties.Name="Choose output" />
                    <Button x:Name="ExportButton" Grid.Column="11"
                            Style="{StaticResource OutlineButton}"
                            Padding="10,0"
                            Content="Export"
                            ToolTip="Export only this set now"
                            AutomationProperties.Name="Export this set" />
                    <Button x:Name="DeleteButton" Grid.Column="13"
                            Style="{StaticResource IconButton}"
                            Content="&#xE74D;"
                            ToolTip="Delete this set"
                            AutomationProperties.Name="Delete set" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Export schedules" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Each set sends one schedule to a workbook sheet or CSV folder. Changes are saved to the project when you close." />
        </StackPanel>

        <!-- Sets card -->
        <Border Grid.Row="1" Style="{StaticResource WwpCard}" Padding="12,14,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Card toolbar -->
                <DockPanel Grid.Row="0" Margin="8,0,0,6" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SetsFileButton" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                ToolTip="Load sets from, or save them to, a .settings file"
                                AutomationProperties.Name="Sets file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sets file" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                           VerticalAlignment="Center" Margin="8,1,0,0" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource WwpContextMenu}">
                                    <MenuItem x:Name="LoadFileMenuItem" Header="Load sets from file..." />
                                    <MenuItem x:Name="SaveFileMenuItem" Header="Save sets to file..." />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}"
                                ToolTip="Excel or CSV, headers, titles, sheet names and delimiter">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Export sets" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="SetCountText" Style="{StaticResource CaptionText}"
                                   VerticalAlignment="Center" Margin="10,1,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- Table, then the add-set line under its last row -->
                <ScrollViewer Grid.Row="1"
                              VerticalAlignment="Top"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <!-- Lane layer: stops at the last row because it shares the table's cell. -->
                            <Grid Margin="8,0,8,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="250" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="3" Style="{StaticResource TableLane}"
                                        Background="{StaticResource LaneBlueBrush}" />
                                <Border Grid.Column="5" Grid.ColumnSpan="5" Style="{StaticResource TableLane}"
                                        Background="{StaticResource LaneGreenBrush}" />
                            </Grid>

                            <StackPanel>
                                <!-- Lane labels -->
                                <Grid Margin="8,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="3" Text="SOURCE"
                                               Style="{StaticResource TableGroupLabel}"
                                               Foreground="{StaticResource LaneBlueTextBrush}" />
                                    <TextBlock Grid.Column="5" Grid.ColumnSpan="5" Text="OUTPUT"
                                               Style="{StaticResource TableGroupLabel}"
                                               Foreground="{StaticResource LaneGreenTextBrush}" />
                                </Grid>

                                <!-- Column headers: name over qualifier -->
                                <Grid Margin="8,6,8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="Set&#x0a;name" Style="{StaticResource TableHeader}" />
                                    <TextBlock Grid.Column="3" Text="Schedule&#x0a;Revit view" Style="{StaticResource TableHeader}" />
                                    <TextBlock Grid.Column="5" Text="Sheet&#x0a;workbook tab" Style="{StaticResource TableHeader}" />
                                    <TextBlock Grid.Column="7" Grid.ColumnSpan="3" Text="Output&#x0a;.xlsx file or CSV folder"
                                               Style="{StaticResource TableHeader}" />
                                </Grid>

                                <!-- One SetRowTemplate per saved set -->
                                <StackPanel x:Name="RowsHost" />
                            </StackPanel>
                        </Grid>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,20,0,8"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="No export sets yet" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="Add a set, pick a schedule, then choose where it goes." />
                        </StackPanel>

                        <!-- Add a set: sits under the last row -->
                        <Border BorderBrush="{StaticResource TableDividerBrush}" BorderThickness="0,1,0,0"
                                Margin="8,0,8,0" Padding="0,4,0,0">
                            <Button x:Name="AddSetButton" Style="{StaticResource AddRowButton}"
                                    Margin="-8,0,0,0"
                                    ToolTip="Add an empty set"
                                    AutomationProperties.Name="Add set">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Text="Add set" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage" DockPanel.Dock="Left" Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportSelectedButton" Content="Export selected" MinWidth="140"
                        Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="CancelButton" Content="Close" MinWidth="88" IsCancel="True"
                        ToolTip="Save your changes to the project and close" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
