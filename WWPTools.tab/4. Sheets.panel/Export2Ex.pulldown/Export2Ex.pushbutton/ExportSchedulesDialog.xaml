<!--
  Export2Ex - By Schedule: export settings, opened from the Settings button of the main window
  (BatchExportDialog.xaml). Export2ex-script.py (_show_export_settings_popup) reads and writes
  every named control below.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Settings"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <StackPanel Margin="{StaticResource PageMargin}">
        <TextBlock Text="Export settings" Style="{StaticResource PageTitle}" FontSize="20" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Defaults for new sets and for sets saved without their own options." />

        <Border Style="{StaticResource WwpCard}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Export to" Style="{StaticResource SectionHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <RadioButton x:Name="ExcelMode" Content="Excel workbook" GroupName="ExportMode"
                                 Margin="0,0,24,0" />
                    <RadioButton x:Name="CsvMode" Content="CSV files" GroupName="ExportMode" />
                </StackPanel>

                <TextBlock Text="Schedule appearance" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="ExportTitle" Style="{StaticResource ToggleSwitchCheckBox}"
                          Content="Export title" Margin="0,0,0,10" />
                <CheckBox x:Name="ExportColumnHeaders" Style="{StaticResource ToggleSwitchCheckBox}"
                          Content="Export column headers" Margin="0,0,0,10" />
                <CheckBox x:Name="ExportGroupedColumnHeaders" Style="{StaticResource ToggleSwitchCheckBox}"
                          Content="Include grouped column headers" Margin="50,0,0,10" />
                <CheckBox x:Name="ExportGroupHeaders" Style="{StaticResource ToggleSwitchCheckBox}"
                          Content="Export group headers, footers and blank lines" Margin="0,0,0,10" />
                <CheckBox x:Name="UseCategorySheetName" Style="{StaticResource ToggleSwitchCheckBox}"
                          Content="Name each sheet after the schedule's category" Margin="0,0,0,18" />

                <TextBlock Text="Text format" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Delimiter" VerticalAlignment="Center" />
                    <ComboBox x:Name="CsvDelimiter" Grid.Column="2" />
                </Grid>
                <CheckBox x:Name="QuoteAll" Style="{StaticResource ToggleSwitchCheckBox}"
                          Content="Quote all fields" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                           Text="The delimiter is also used to read the schedule back when building Excel sheets." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ApplyButton" Content="Apply" MinWidth="96" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButton}" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
