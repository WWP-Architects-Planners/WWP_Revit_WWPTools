<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Sheets from Excel"
        Height="820" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" UseLayoutRounding="True">
    <!-- Page background and type are set on the Window itself so they also apply when this is
         loaded as a pyRevit WPFWindow subclass (which skips the theme's implicit Window style). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource PageMargin}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="200" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Print Sheets from Excel" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="DocTitleText" Text="Active Document" Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Excel Database" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                            <TextBlock Text="Column A: Printed File Name (overrides naming format), Column B: Drawing Name, Column C: Drawing Number" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                            <TextBox x:Name="ExcelPathBox" IsReadOnly="True" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BrowseExcelButton" Content="Browse Excel" MinWidth="120" />
                                <Button x:Name="GenerateExcelButton" Content="Generate/Update" MinWidth="140" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sheet Selection" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="Sheet Set" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SheetSetCombo" />
                            <CheckBox x:Name="UseSelectedSheetsCheck" Content="Use selected sheets only" Margin="0,10,0,8" />
                            <ListBox x:Name="SheetListBox" SelectionMode="Extended" Height="200" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Output Folder" Style="{StaticResource SectionHeader}" />
                            <TextBox x:Name="OutputPathBox" IsReadOnly="True" />
                            <Button x:Name="BrowseOutputButton" Content="Choose Folder" MinWidth="120" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Export Options" Style="{StaticResource SectionHeader}" />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="PdfToggle" Content="PDF" IsChecked="True" Style="{StaticResource ToggleSwitch}" Margin="0,0,24,0" />
                                <ToggleButton x:Name="DwgToggle" Content="DWG" Style="{StaticResource ToggleSwitch}" />
                            </StackPanel>
                            <TextBlock Text="Naming Format" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <TextBox x:Name="NamingFormatBox" Text="{}{number}_{name}" />
                            <TextBlock Text="{}Tokens: {index} {number} {name} {name_dash} {name_underline} {current_date} {issue_date} {rev_number} {rev_desc} {rev_date}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                            <TextBlock Text="{}Project/user tokens: {proj_name} {proj_number} {proj_building_name} {proj_issue_date} {proj_org_name} {proj_status} {username} {revit_version}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            <TextBlock Text="{}Param tokens: {sheet_param:PARAM} {tblock_param:PARAM} {proj_param:PARAM} {glob_param:PARAM} | Excel: {excel_name} {excel_number}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="16" Background="Transparent" />

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Schedule One-Time Print" Style="{StaticResource SectionHeader}" Margin="0,0,0,2" />
                            <TextBlock Text="Revit must remain open until the scheduled time." Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                            <TextBlock Text="Date" Style="{StaticResource FieldLabel}" />
                            <DatePicker x:Name="ScheduleDatePicker" MinHeight="32" VerticalContentAlignment="Center"
                                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource InputStrokeBrush}" />
                            <TextBlock Text="Time (HH:MM, 24h)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                            <TextBox x:Name="ScheduleTimeBox" Text="09:00" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                <Button x:Name="ScheduleButton" Content="Schedule" MinWidth="120" />
                                <Button x:Name="CancelScheduleButton" Content="Cancel Schedule" MinWidth="140" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="ScheduleStatusText" Text="No schedule" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Notes" Style="{StaticResource SectionHeader}" />
                            <TextBlock Text="- Drawing Name (Column B) must match sheet names exactly." TextWrapping="Wrap" />
                            <TextBlock Text="- Printed File Name (Column A) controls output names." TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="- Use Generate/Update to build the database from sheets." TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource WwpCard}" Padding="16,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Log" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" />
                </DockPanel>
            </Border>

            <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
                <Image x:Name="LogoImage" Style="{StaticResource BrandLogoFooter}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Button x:Name="PrintNowButton" Content="Print Now" Style="{StaticResource PrimaryButton}" MinWidth="140" DockPanel.Dock="Right" />
            </DockPanel>
        </Grid>
    </ScrollViewer>
</Window>
