<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Center"
        ResizeMode="CanResizeWithGrip" SizeToContent="Height" Width="1000" MinHeight="500"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" UseLayoutRounding="True"
        Title="Naming Formats" Closing="cancelled">
    <!-- pyRevit WPFWindow subclasses do not pick up the theme's implicit Window style,
         so the page background and type are set on the Window itself. -->
    <Window.Resources>
        <Style x:Key="FormatterTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding builtin}" Value="True">
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Token chip: the lane wash of its group as fill, the lane text colour as ink. -->
        <Style x:Key="TagButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource Self}}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CAPS group label above a row of chips (left-aligned TableGroupLabel). -->
        <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource TableGroupLabel}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="200" Width="1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition MinWidth="530" Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: saved format list -->
            <Border Grid.Column="0" Style="{StaticResource WwpCard}">
                <DockPanel>
                    <TextBlock Text="Naming Formats" Style="{StaticResource SectionHeader}" DockPanel.Dock="Top" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Create"    Padding="6,0" Margin="0,0,4,0" Click="create_namingformat"/>
                        <Button Grid.Column="1" Content="Duplicate" Padding="6,0" Margin="2,0,2,0" Click="duplicate_namingformat"/>
                        <Button Grid.Column="2" Content="Delete"    Padding="6,0" Margin="4,0,0,0" Click="delete_namingformat"/>
                    </Grid>
                    <ListBox x:Name="formats_lb" FontFamily="Consolas"
                             SelectionChanged="namingformat_changed" SelectionMode="Single" SelectedIndex="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding name}" RecognizesAccessKey="False"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="12" Background="Transparent" />

            <!-- RIGHT: format editor -->
            <Border Grid.Column="2" Style="{StaticResource WwpCard}">
                <DockPanel x:Name="namingformat_edit">

                    <!-- Title + template fields (fixed at top) -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Format Title" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource CaptionText}">
                            Give this format a descriptive name, e.g. "City of Portland ePermit"
                        </TextBlock>
                        <TextBox x:Name="template_name_tb"
                                 Text="{Binding name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormatterTextBox}"/>

                        <TextBlock Text="Template" Style="{StaticResource FieldLabel}" FontWeight="SemiBold" Margin="0,16,0,2" />
                        <TextBlock Style="{StaticResource CaptionText}">
                            Click a tag below to insert it at the cursor position in this box.
                        </TextBlock>
                        <TextBox x:Name="template_tb"
                                 Text="{Binding template, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormatterTextBox}"/>
                    </StackPanel>

                    <!-- Scrollable tag/picker panel -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <StackPanel>

                            <!-- SHEET -->
                            <TextBlock Style="{StaticResource SectionLabel}" Foreground="{StaticResource LaneBlueTextBrush}" Text="SHEET"/>
                            <WrapPanel>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneTealBrush}" Foreground="{StaticResource LaneTealTextBrush}"
                                        Tag="{}{index}" Content="{}{index}"
                                        ToolTip="Print Index Number e.g. 0001" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneBlueBrush}" Foreground="{StaticResource LaneBlueTextBrush}"
                                        Tag="{}{number}" Content="{}{number}"
                                        ToolTip="Sheet Number e.g. A1.00" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneBlueBrush}" Foreground="{StaticResource LaneBlueTextBrush}"
                                        Tag="{}{name}" Content="{}{name}"
                                        ToolTip="Sheet Name e.g. 1ST FLOOR PLAN" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneBlueBrush}" Foreground="{StaticResource LaneBlueTextBrush}"
                                        Tag="{}{name_dash}" Content="{}{name_dash}"
                                        ToolTip="Sheet Name with hyphens for spaces" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneBlueBrush}" Foreground="{StaticResource LaneBlueTextBrush}"
                                        Tag="{}{name_underline}" Content="{}{name_underline}"
                                        ToolTip="Sheet Name with underscores for spaces" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneGreyBrush}" Foreground="{StaticResource LaneGreyTextBrush}"
                                        Tag="{}{issue_date}" Content="{}{issue_date}"
                                        ToolTip="Sheet Issue Date e.g. 2019-10-12" Click="insert_formatter"/>
                            </WrapPanel>

                            <!-- REVISION -->
                            <TextBlock Style="{StaticResource SectionLabel}" Foreground="{StaticResource LaneAmberTextBrush}" Text="REVISION"/>
                            <WrapPanel>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneAmberBrush}" Foreground="{StaticResource LaneAmberTextBrush}"
                                        Tag="{}{rev_number}" Content="{}{rev_number}"
                                        ToolTip="Current Revision Number e.g. 01" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneAmberBrush}" Foreground="{StaticResource LaneAmberTextBrush}"
                                        Tag="{}{rev_desc}" Content="{}{rev_desc}"
                                        ToolTip="Current Revision Description e.g. ASI01" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneAmberBrush}" Foreground="{StaticResource LaneAmberTextBrush}"
                                        Tag="{}{rev_date}" Content="{}{rev_date}"
                                        ToolTip="Current Revision Date e.g. 2019-10-12" Click="insert_formatter"/>
                            </WrapPanel>

                            <!-- PROJECT -->
                            <TextBlock Style="{StaticResource SectionLabel}" Foreground="{StaticResource LaneVioletTextBrush}" Text="PROJECT"/>
                            <WrapPanel>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneVioletBrush}" Foreground="{StaticResource LaneVioletTextBrush}"
                                        Tag="{}{proj_name}" Content="{}{proj_name}"
                                        ToolTip="Project Name" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneVioletBrush}" Foreground="{StaticResource LaneVioletTextBrush}"
                                        Tag="{}{proj_number}" Content="{}{proj_number}"
                                        ToolTip="Project Number e.g. PR2019.12" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneVioletBrush}" Foreground="{StaticResource LaneVioletTextBrush}"
                                        Tag="{}{proj_building_name}" Content="{}{proj_building_name}"
                                        ToolTip="Project Building Name" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneVioletBrush}" Foreground="{StaticResource LaneVioletTextBrush}"
                                        Tag="{}{proj_issue_date}" Content="{}{proj_issue_date}"
                                        ToolTip="Project Issue Date" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneVioletBrush}" Foreground="{StaticResource LaneVioletTextBrush}"
                                        Tag="{}{proj_org_name}" Content="{}{proj_org_name}"
                                        ToolTip="Project Organization Name" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneVioletBrush}" Foreground="{StaticResource LaneVioletTextBrush}"
                                        Tag="{}{proj_status}" Content="{}{proj_status}"
                                        ToolTip="Project Status" Click="insert_formatter"/>
                            </WrapPanel>

                            <!-- SYSTEM -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SYSTEM"/>
                            <WrapPanel>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneGreyBrush}" Foreground="{StaticResource LaneGreyTextBrush}"
                                        Tag="{}{current_date}" Content="{}{current_date}"
                                        ToolTip="Today's Date e.g. 2019-10-12" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneGreyBrush}" Foreground="{StaticResource LaneGreyTextBrush}"
                                        Tag="{}{username}" Content="{}{username}"
                                        ToolTip="Active Revit Username" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneGreyBrush}" Foreground="{StaticResource LaneGreyTextBrush}"
                                        Tag="{}{revit_version}" Content="{}{revit_version}"
                                        ToolTip="Active Revit Version e.g. 2024" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneGreyBrush}" Foreground="{StaticResource LaneGreyTextBrush}"
                                        Tag="{}{excel_name}" Content="{}{excel_name}"
                                        ToolTip="Excel/CSV Drawing Name (Column B)" Click="insert_formatter"/>
                                <Button Style="{StaticResource TagButton}" Background="{StaticResource LaneGreyBrush}" Foreground="{StaticResource LaneGreyTextBrush}"
                                        Tag="{}{excel_number}" Content="{}{excel_number}"
                                        ToolTip="Excel/CSV Drawing Number (Column C)" Click="insert_formatter"/>
                            </WrapPanel>

                            <!-- SHEET PARAMETER -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="SHEET PARAMETER"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="sheet_param_cb" Width="310"
                                          VerticalContentAlignment="Center" IsEditable="True"/>
                                <Button Content="+ Insert" Margin="8,0,0,0"
                                        Click="insert_sheet_param"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">Inserts as {sheet_param:PARAM_NAME}. Populated from the first sheet in the model.</TextBlock>

                            <!-- TITLEBLOCK PARAMETER -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="TITLEBLOCK PARAMETER"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="tblock_param_cb" Width="310"
                                          VerticalContentAlignment="Center" IsEditable="True"/>
                                <Button Content="+ Insert" Margin="8,0,0,0"
                                        Click="insert_tblock_param"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">Inserts as {tblock_param:PARAM_NAME}. Populated from title block parameters in the model.</TextBlock>

                            <!-- PROJECT PARAMETER -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="PROJECT PARAMETER"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="proj_param_cb" Width="310"
                                          VerticalContentAlignment="Center" IsEditable="True"/>
                                <Button Content="+ Insert" Margin="8,0,0,0"
                                        Click="insert_proj_param"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">Inserts as {proj_param:PARAM_NAME}. Populated from Project Information parameters.</TextBlock>

                            <!-- GLOBAL PARAMETER -->
                            <TextBlock Style="{StaticResource SectionLabel}" Text="GLOBAL PARAMETER"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="glob_param_cb" Width="310"
                                          VerticalContentAlignment="Center" IsEditable="True"/>
                                <Button Content="+ Insert" Margin="8,0,0,0"
                                        Click="insert_glob_param"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">Inserts as {glob_param:PARAM_NAME}. Populated from Global Parameters in the model.</TextBlock>

                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="1" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage" Style="{StaticResource BrandLogoFooter}"
                   DockPanel.Dock="Left" VerticalAlignment="Center" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    DockPanel.Dock="Right" Click="save_formats"/>
        </DockPanel>
    </Grid>
</Window>
