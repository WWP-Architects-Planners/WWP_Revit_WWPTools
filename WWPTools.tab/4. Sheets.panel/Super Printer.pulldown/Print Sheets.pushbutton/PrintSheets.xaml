<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Sheets" Height="900" Width="1500" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" HorizontalContentAlignment="Center"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13.5" UseLayoutRounding="True">
    <!-- pyRevit WPFWindow subclasses do not pick up the theme's implicit Window style,
         so the page background and type are set on the Window itself. -->
    <Window.Resources>
        <!-- Print index: accent ink, right-aligned, no lane. -->
        <Style x:Key="IndexColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Sheet identity cells (Blue source lane): tooltip, copy menu, greyed out when not printable.
             The theme has no disabled-text brush; StrongBorderBrush matches its 50% disabled grey. -->
        <Style x:Key="DefaultColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource LaneBlueCell}">
            <Setter Property="ToolTip" Value="{Binding tooltip}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource ItemContextMenu}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding printable}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource StrongBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Same behaviour for the File Name cells in the Green output lane. -->
        <Style x:Key="OutputColumnStyle" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource LaneGreenCell}">
            <Setter Property="ToolTip" Value="{Binding tooltip}"/>
            <Setter Property="ContextMenu" Value="{DynamicResource ItemContextMenu}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding printable}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource StrongBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Revision: date | number | description as one segmented chip. -->
        <DataTemplate x:Key="RevisionCell">
            <StackPanel x:Name="revinfo" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4,0,0,4" MinWidth="16" Padding="6,1">
                    <TextBlock Text="{Binding revision.date}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1"
                        MinWidth="16" Padding="6,1">
                    <TextBlock Text="{Binding revision.number}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,1"
                        CornerRadius="0,4,4,0" MinWidth="16" Padding="6,1">
                    <TextBlock Text="{Binding revision.desc}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding revision.is_set}" Value="False">
                    <Setter TargetName="revinfo" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="PrintSettingCell">
            <StackPanel x:Name="psettinginfo" VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="6,1">
                    <TextBlock x:Name="psettingname" Text="{Binding print_settings.Name}" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding read_only}" Value="True">
                    <Setter TargetName="psettingname" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Looked up from code (Resources["printSettingsItem"]) for the print setting picker. -->
        <DataTemplate x:Key="printSettingsItem">
            <WrapPanel>
                <TextBlock x:Name="sizeName" Text="{Binding name}" VerticalAlignment="Center" />
                <Border x:Name="incompatibleMarker" Background="{StaticResource DangerSoftBrush}" Margin="8,0,0,0" CornerRadius="4"
                        Padding="6,1" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Left" Text="Incompatible with printer" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                </Border>
            </WrapPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding is_compatible}" Value="True">
                    <Setter TargetName="incompatibleMarker" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="sizeName" Property="Foreground" Value="{StaticResource TextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding is_compatible}" Value="False">
                    <Setter TargetName="incompatibleMarker" Property="Visibility" Value="Visible" />
                    <Setter TargetName="sizeName" Property="Foreground" Value="{StaticResource MutedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="{StaticResource PageMargin}">
        <StackPanel DockPanel.Dock="Top">
            <!-- Source: model and sheet index -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Model" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="documents_cb" Grid.Column="1" SelectionChanged="doclist_changed" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="docname" Text="{Binding name}" />
                                <TextBlock x:Name="docname_linked" Text="{Binding name, StringFormat=Linked: {0}}" Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding linked}" Value="True">
                                    <Setter TargetName="docname" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="docname_linked" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="3" Text="Sheet Index" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="schedules_cb" Grid.Column="4" SelectionChanged="sheetlist_changed" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Text="{Binding name}" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Options: three cards across, then naming + schedule -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Header="Sheet Ordering" Grid.Row="0" Grid.Column="0">
                    <StackPanel>
                        <CheckBox x:Name="reverse_cb" IsChecked="False" Click="options_changed">Reverse Print Order</CheckBox>
                        <StackPanel x:Name="order_sp" Margin="0,8,0,0">
                            <CheckBox x:Name="placeholder_cb" IsChecked="True" Click="options_changed">Show Non-Printable Sheets (Grayed Out)</CheckBox>
                            <CheckBox x:Name="indexspace_cb" Margin="0,8,0,0" IsChecked="True" Click="options_changed">Include Non-Printable Sheets in Indexing</CheckBox>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="Index Digits" Width="90" VerticalAlignment="Center" DockPanel.Dock="Left" />
                                <Slider x:Name="index_slider" Margin="0" VerticalAlignment="Center"
                                        Minimum="3" Maximum="6" TickPlacement="TopLeft" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                        ValueChanged="options_changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Index Start" Width="90" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Content="Reset" DockPanel.Dock="Right" Margin="8,0,0,0"
                                        Click="rest_index" />
                                <TextBox x:Name="indexstart_tb" Text="0" VerticalContentAlignment="Center"
                                         PreviewTextInput="validate_index_start" TextChanged="options_changed"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sheet Printing" Grid.Row="0" Grid.Column="2">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <CheckBox x:Name="export_pdf" DockPanel.Dock="Right" Margin="0,0,16,0" IsChecked="True" IsEnabled="True" Checked="options_changed" Unchecked="options_changed">Export PDF</CheckBox>
                            <CheckBox x:Name="combine_cb" DockPanel.Dock="Right" Margin="0,0,16,0" IsChecked="False" IsEnabled="True" Checked="options_changed" Unchecked="options_changed">Combine Into One PDF</CheckBox>
                            <CheckBox x:Name="export_dwg" DockPanel.Dock="Right" Margin="0,0,0,0" IsChecked="False" IsEnabled="True" Checked="options_changed" Unchecked="options_changed">Export DWG</CheckBox>
                            </StackPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Printer" Width="100" VerticalAlignment="Center"/>
                                <ComboBox x:Name="printers_cb" SelectionChanged="printers_changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Page Settings" Width="100" VerticalAlignment="Center"/>
                                <ComboBox x:Name="printsettings_cb" SelectionChanged="sheetlist_changed" ItemTemplate="{StaticResource printSettingsItem}" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Output Folder" Width="100" VerticalAlignment="Center"/>
                                <Button x:Name="output_browse_b" Content="Browse" DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" Click="browse_output"/>
                                <TextBox x:Name="output_dir_tb" IsReadOnly="True" VerticalContentAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="CSV Database" Grid.Row="0" Grid.Column="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource CaptionText}" Text="Column A: Printed File Name (override), Column B: Drawing Name, Column C: Drawing Number" />
                        <CheckBox x:Name="excel_writeback_cb" Grid.Row="1" Grid.ColumnSpan="3" Content="Write to CSV before print" Margin="0,8,0,0" IsChecked="True" />
                        <TextBox x:Name="excel_path_tb" Grid.Row="2" Grid.Column="0" IsReadOnly="True" Margin="0,8,8,0" VerticalContentAlignment="Center"/>
                        <Button x:Name="excel_browse_b" Grid.Row="2" Grid.Column="1" Content="Browse" MinWidth="80" Margin="0,8,8,0" Click="browse_excel"/>
                        <Button x:Name="excel_generate_b" Grid.Row="2" Grid.Column="2" Content="Generate/Update" Margin="0,8,0,0" Click="generate_excel"/>
                        <CheckBox x:Name="csv_include_ext_cb" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Include file extension in Printed File Name" Margin="0,8,8,0" VerticalAlignment="Center" IsChecked="False" />
                        <Button x:Name="excel_dryrun_b" Grid.Row="3" Grid.Column="2" Content="CSV Only (Dry Run)" Margin="0,8,0,0" Click="write_excel_dry_run"/>
                    </Grid>
                </GroupBox>

                <Grid Grid.Row="1" Grid.ColumnSpan="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Naming Format" Grid.Column="0">
                    <DockPanel x:Name="namingformat_dp" VerticalAlignment="Center">
                        <TextBlock Text="Naming Format" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="Edit Formats" DockPanel.Dock="Right" MinWidth="100" Margin="8,0,0,0" Click="edit_formats"/>
                        <ComboBox x:Name="namingformat_cb" FontFamily="Consolas" VerticalContentAlignment="Center" SelectionChanged="options_changed" >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Padding="0,1,5,1">
                                            <TextBlock Text="{Binding name}"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="Schedule One-Time Print" Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="Revit must remain open until the scheduled time." Style="{StaticResource CaptionText}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Date" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker x:Name="schedule_date" Width="140" MinHeight="32" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource InputStrokeBrush}" Margin="0,0,16,0"/>
                            <TextBlock Text="Time (HH:MM)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="schedule_time_tb" Width="80" Margin="0,0,16,0"/>
                            <Button x:Name="schedule_b" Content="Schedule" MinWidth="90" Margin="0,0,8,0" Click="schedule_print"/>
                            <Button x:Name="cancel_schedule_b" Content="Cancel" MinWidth="90" Click="cancel_schedule"/>
                        </StackPanel>
                        <TextBlock x:Name="schedule_status_tb" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </GroupBox>
                </Grid>
            </Grid>
        </StackPanel>

        <!-- Footer: logo left, the print action right. -->
        <DockPanel DockPanel.Dock="Bottom" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage" Style="{StaticResource BrandLogoFooter}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
            <Button x:Name="print_b" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" MinWidth="120"
                    ToolTip="Print" AutomationProperties.Name="Print" Click="print_sheets">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                          Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Print" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DockPanel>

        <!-- Sheet table card -->
        <Border Style="{StaticResource WwpCard}" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,4,4,8">
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0" TextWrapping="WrapWithOverflow">
                        List of the sheets in selected sheet index
                    </TextBlock>
                    <Border x:Name="errormsg_block" Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="errormsg_tb" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="varsizeguide" Padding="10,8" Background="{StaticResource InfoSoftBrush}" CornerRadius="6" Margin="0,8,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <DockPanel x:Name="sheetopts_wp" DockPanel.Dock="Right" IsEnabled="False">
                                <DockPanel DockPanel.Dock="Bottom">
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Set Print Settings" Click="set_sheet_printsettings"/>
                                    <Button DockPanel.Dock="Left" Content="Reset Print Settings " Click="sheetlist_changed"/>
                                </DockPanel>
                                <Grid />
                            </DockPanel>
                            <Expander Header="Guide" Cursor="Help" VerticalAlignment="Center">
                                <TextBlock Margin="5,5,0,0" TextWrapping="Wrap">
                                    Print settings can be set on titleblock types. Create a "Print Setting" type parameter (of type Text) on a titleblock family,
                                    and set the parameter value to the name of the desired print setting. When using "Variable Paper Size", this tool will
                                    automatically assign the correct print setting based on the value of this parameter
                                </TextBlock>
                            </Expander>
                        </DockPanel>
                    </Border>
                </StackPanel>
                <!-- SelectionMode is explicit: the theme defaults DataGrids to Single, this table needs multi-select. -->
                <DataGrid x:Name="sheets_lb"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          CanUserSortColumns="True"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="sheet_selection_changed">
                    <DataGrid.Resources>
                        <ContextMenu x:Key="ItemContextMenu">
                            <MenuItem  Header="Copy Sheet File Name(s)" Click="copy_filenames" />
                        </ContextMenu>
                    </DataGrid.Resources>

                    <!-- Blue lane: sheet identity (source). Green lane: print outputs. -->
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Print&#x0a;Index" Binding="{Binding print_index}" MinWidth="70" Width="70" IsReadOnly="True"
                                            HeaderStyle="{StaticResource NumberHeader}" CellStyle="{StaticResource IndexColumnStyle}" ElementStyle="{StaticResource TableNumberText}"/>
                        <DataGridTextColumn Header="Sheet Number" Binding="{Binding number}" MinWidth="100" Width="100" IsReadOnly="True"
                                            HeaderStyle="{StaticResource LaneBlueHeader}" CellStyle="{StaticResource DefaultColumnStyle}"/>
                        <DataGridTextColumn Header="Sheet Name" Binding="{Binding name}" MinWidth="400" Width="400" IsReadOnly="True"
                                            HeaderStyle="{StaticResource LaneBlueHeader}" CellStyle="{StaticResource DefaultColumnStyle}"/>
                        <DataGridTemplateColumn Header="Sheet Revision&#x0a;sort by date" MinWidth="50" Width="1*" IsReadOnly="True"
                                                HeaderStyle="{StaticResource LaneBlueHeader}" CellStyle="{StaticResource LaneBlueCell}"
                                                CellTemplate="{StaticResource RevisionCell}" SortMemberPath="revision_date_sortable" />
                        <DataGridTemplateColumn Width="6" MinWidth="6" HeaderStyle="{StaticResource LaneGapHeader}" CellStyle="{StaticResource LaneGapCell}" CanUserResize="False" />
                        <DataGridTemplateColumn x:Name="psettingcol" Header="Print Setting" MinWidth="50" Width="*" IsReadOnly="True"
                                                HeaderStyle="{StaticResource LaneGreenHeader}" CellStyle="{StaticResource LaneGreenCell}"
                                                CellTemplate="{StaticResource PrintSettingCell}" Visibility="Collapsed"/>
                        <DataGridTextColumn x:Name="pfilename" Header="File Name" FontFamily="Consolas" Binding="{Binding print_filename}" MinWidth="50" Width="2*" IsReadOnly="True"
                                            HeaderStyle="{StaticResource LaneGreenHeader}" CellStyle="{StaticResource OutputColumnStyle}" Visibility="Collapsed"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
