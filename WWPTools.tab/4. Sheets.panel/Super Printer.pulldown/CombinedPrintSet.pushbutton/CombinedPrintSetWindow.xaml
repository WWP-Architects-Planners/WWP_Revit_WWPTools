<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Combined Print Set"
        Width="1520"
        Height="920"
        MinWidth="1260"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTitle"
                       Style="{StaticResource PageTitle}"
                       Text="Combined Print Set"/>
            <TextBlock x:Name="HeaderSubtitle"
                       Style="{StaticResource PageSubtitle}"
                       Text="Load sheets from open or closed Revit models, arrange the final order, and print one merged PDF drawing set."/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               LastChildFill="False">
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Margin="0"
                                   VerticalAlignment="Center"
                                   Text="Source Models"/>
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Right">
                            <Button x:Name="BtnAddFiles"
                                    Width="110"
                                    Margin="0,0,8,0"
                                    Content="Add Files"/>
                            <Button x:Name="BtnRemoveSource"
                                    Width="130"
                                    Content="Remove Source"/>
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="SourcesList"
                             Grid.Row="2"/>

                    <TextBlock Grid.Row="4"
                               Style="{StaticResource SectionHeader}"
                               Text="Available Sheets"/>

                    <TextBox x:Name="TxtSheetFilter"
                             Grid.Row="5"
                             VerticalContentAlignment="Center"
                             ToolTip="Filter sheets in the selected source model"/>

                    <ListBox x:Name="AvailableSheetsList"
                             Grid.Row="7"
                             SelectionMode="Extended"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">
                <Button x:Name="BtnAddSelected"
                        Margin="0,0,0,8"
                        Content="Add >"/>
                <Button x:Name="BtnAddAll"
                        Content="Add All >>"/>
            </StackPanel>

            <Border Grid.Column="4"
                    Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Margin="0"
                                   Text="Ordered Print Set"/>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0"
                                   Text="The right-hand list defines the final PDF page order. Use the move buttons to sort sheets across models."/>
                    </StackPanel>

                    <ListBox x:Name="SelectedSheetsList"
                             Grid.Row="2"
                             SelectionMode="Extended"/>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSummary"
                                       Style="{StaticResource MutedText}"
                                       VerticalAlignment="Center"
                                       Text=""/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="PDF Printer"/>
                            <ComboBox x:Name="CmbPrinter"
                                      MinWidth="340"/>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Margin="0,12,0,6"
                                       Text="Output PDF"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOutputPath"
                                         Grid.Column="0"
                                         MinWidth="360"/>
                                <Button x:Name="BtnBrowseOutput"
                                        Grid.Column="2"
                                        Content="Browse"/>
                            </Grid>

                            <TextBlock x:Name="TxtWarning"
                                       Margin="0,10,0,0"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Text=""/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="6"
                        VerticalAlignment="Center">
                <Button x:Name="BtnMoveTop"
                        Margin="0,0,0,8"
                        Content="Top"/>
                <Button x:Name="BtnMoveUp"
                        Margin="0,0,0,8"
                        Content="Up"/>
                <Button x:Name="BtnMoveDown"
                        Margin="0,0,0,8"
                        Content="Down"/>
                <Button x:Name="BtnMoveBottom"
                        Margin="0,0,0,16"
                        Content="Bottom"/>
                <Button x:Name="BtnRemoveSelected"
                        Margin="0,0,0,8"
                        Content="Remove"/>
                <Button x:Name="BtnClearSet"
                        Content="Clear"/>
            </StackPanel>
        </Grid>

        <DockPanel Grid.Row="3"
                   Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   Style="{StaticResource BrandLogoFooter}"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button x:Name="BtnCancel"
                        Width="110"
                        Margin="0,0,8,0"
                        Content="Cancel"/>
                <Button x:Name="BtnPrint"
                        Style="{StaticResource PrimaryButton}"
                        Width="150"
                        Content="Print PDF Set"/>
            </StackPanel>
            <TextBlock x:Name="FooterStatus"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Text=""/>
        </DockPanel>
    </Grid>
</Window>
