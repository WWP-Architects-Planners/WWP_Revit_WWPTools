<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheet Duplicator"
        Width="1380"
        Height="900"
        MinWidth="1120"
        MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderTitle"
                       Style="{StaticResource PageTitle}"
                       Text="Sheet Duplicator"/>
            <TextBlock x:Name="HeaderSubtitle"
                       Style="{StaticResource PageSubtitle}"
                       Text="Duplicate one source sheet with the same viewport locations. Each viewport can get a newly duplicated view name before the new sheet is created."/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Text="Sheet Setup"/>

                        <TextBlock Style="{StaticResource FieldLabel}"
                                   Text="Source sheet"/>
                        <ComboBox x:Name="CmbSourceSheet"
                                  MinWidth="240"/>

                        <TextBlock Margin="0,12,0,4"
                                   Style="{StaticResource FieldLabel}"
                                   Text="Source titleblock"/>
                        <TextBlock x:Name="TxtTitleblock"
                                   Style="{StaticResource MutedText}"
                                   Text=""/>

                        <!-- Number and name share a row to leave room for the assignment list below. -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="New sheet number"/>
                                <TextBox x:Name="TxtSheetNumber"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="New sheet name"/>
                                <TextBox x:Name="TxtSheetName"
                                         MinWidth="200"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="View duplicate mode"/>
                            <ComboBox x:Name="CmbDuplicateOption"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="6,0,0,0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Name template"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtViewPrefix"
                                         Grid.Column="0"/>
                                <TextBox x:Name="TxtViewSuffix"
                                         Grid.Column="2"/>
                            </Grid>
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource CaptionText}"
                                       Text="Prefix and suffix for newly duplicated view names."/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="4">
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,4"
                                   Text="Viewport Assignments"/>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Each row duplicates the source view and places it back on the new sheet at the same viewport location. Views that cannot duplicate will reuse the source view."/>
                    </StackPanel>

                    <Border Grid.Row="6"
                            Style="{StaticResource WwpInset}"
                            Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AssignmentsHost"
                                        Margin="8"/>
                        </ScrollViewer>
                    </Border>

                    <StackPanel Grid.Row="8">
                        <Button x:Name="BtnResetNames"
                                HorizontalAlignment="Left"
                                Content="Reset Target Names"/>
                        <TextBlock x:Name="TxtSummary"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text=""/>
                        <TextBlock x:Name="TxtWarning"
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Text=""/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="16"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2" Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,4"
                                   Text="Sheet Preview"/>
                        <TextBlock Style="{StaticResource CaptionText}"
                                   Text="Grey boxes show the source sheet layout. The new sheet keeps these viewport locations while using the assigned duplicate view names."/>
                    </StackPanel>

                    <Border Grid.Row="2"
                            x:Name="PreviewHost"
                            Style="{StaticResource WwpInset}"
                            Padding="0"
                            MinHeight="420">
                        <Canvas x:Name="PreviewCanvas"
                                ClipToBounds="True"
                                Background="Transparent"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4"
                   LastChildFill="False">
            <TextBlock x:Name="FooterStatus"
                       VerticalAlignment="Center"
                       Style="{StaticResource MutedText}"
                       Text=""/>
            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button x:Name="BtnCancel"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Content="Cancel"/>
                <Button x:Name="BtnCreate"
                        MinWidth="130"
                        Style="{StaticResource PrimaryButton}"
                        Content="Duplicate Sheet"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
