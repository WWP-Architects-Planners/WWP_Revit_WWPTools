<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Views Duplicator"
        Width="500"
        Height="540"
        MinWidth="420"
        MinHeight="540"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WWPTools.WpfUI;component/Themes/FlatTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Views Duplicator"
                       Style="{StaticResource PageTitle}" />
            <TextBlock Text="Duplicate selected views with optional renaming."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Duplicate mode -->
        <Border Grid.Row="2" Style="{StaticResource WwpCard}">
            <StackPanel>
                <TextBlock Text="Duplicate Mode"
                           Style="{StaticResource SectionHeader}" />
                <WrapPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbDuplicate"
                                 Margin="0,2,16,2"
                                 Content="Duplicate View"
                                 ToolTip="Creates an independent copy with no annotation elements." />
                    <RadioButton x:Name="RbDependent"
                                 Margin="0,2,16,2"
                                 Content="As Dependent"
                                 ToolTip="Creates a dependent copy that shares crop and scope with the parent." />
                    <RadioButton x:Name="RbWithDetailing"
                                 Margin="0,2,0,2"
                                 Content="With Detailing"
                                 IsChecked="True"
                                 ToolTip="Creates an independent copy including all annotation and detail elements." />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Source info -->
        <TextBlock x:Name="TxtSource"
                   Grid.Row="4"
                   Style="{StaticResource CaptionText}"
                   Text="Source: Current selection" />

        <!-- Rename fields -->
        <Border Grid.Row="6" Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Find:"
                           Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"
                           ToolTip="Text to find in the original view name. Leave blank to skip find/replace." />
                <TextBox x:Name="TxtFind" Grid.Row="0" Grid.Column="1"
                         ToolTip="Text to find in the original view name. Leave blank to skip find/replace." />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Replace:"
                           Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"
                           ToolTip="Text to replace the found text with in the duplicate name." />
                <TextBox x:Name="TxtReplace" Grid.Row="2" Grid.Column="1"
                         ToolTip="Text to replace the found text with in the duplicate name." />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Prefix:"
                           Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"
                           ToolTip="Text prepended to the duplicate view name. Applied after Find/Replace." />
                <TextBox x:Name="TxtPrefix" Grid.Row="4" Grid.Column="1"
                         ToolTip="Text prepended to the duplicate view name. Applied after Find/Replace." />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Suffix:"
                           Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"
                           ToolTip="Text appended to the duplicate view name. Applied after Find/Replace." />
                <TextBox x:Name="TxtSuffix" Grid.Row="6" Grid.Column="1"
                         Text="-copy"
                         ToolTip="Text appended to the duplicate view name. Applied after Find/Replace." />
            </Grid>
        </Border>

        <!-- Buttons -->
        <DockPanel Grid.Row="8" Style="{StaticResource WwpFooter}">
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True" />
                <Button x:Name="BtnDuplicate"
                        MinWidth="120"
                        Content="Duplicate"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        ToolTip="Duplicate the selected views with the specified rename settings." />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
