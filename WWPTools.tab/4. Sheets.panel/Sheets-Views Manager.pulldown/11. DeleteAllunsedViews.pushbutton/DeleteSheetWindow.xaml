<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delete Sheets by Print Set"
    Width="620" Height="600"
    MinWidth="500" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Delete Sheets by Print Set"
                       Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Select a print set to delete all its sheets."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Print set list -->
                <ListBox x:Name="LstPrintSets"
                         Grid.Row="0"
                         Margin="0,0,0,12"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <!-- Sheet count -->
                <TextBlock Grid.Row="1" x:Name="LblCount"
                           Style="{StaticResource FieldLabel}"/>

                <!-- Sheets preview (read only) -->
                <ListBox x:Name="LstSheets"
                         Grid.Row="2"
                         Background="{StaticResource SurfaceBrush}"
                         Foreground="{StaticResource MutedBrush}"
                         IsHitTestVisible="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <!-- Status -->
                <TextBlock Grid.Row="3" x:Name="LblStatus"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="BtnCancel"
                    Content="Cancel"
                    MinWidth="90"/>
            <Button Grid.Column="3" x:Name="BtnDelete"
                    Content="Delete Sheets"
                    MinWidth="120"
                    Style="{StaticResource DestructiveButton}"/>
        </Grid>
    </Grid>
</Window>
