<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Delete Sheet Set"
    Width="1000" Height="680"
    MinWidth="720" MinHeight="600"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Delete Sheet Set"
                       Style="{StaticResource PageTitle}" />
            <TextBlock Text="Filter by parameter, search, and delete the selected set while continuing to work in Revit."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Main: left filter card + splitter + right lists card -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: filter controls -->
            <Border Grid.Column="0" Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="120" MaxHeight="160" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter Parameter label -->
                    <TextBlock Grid.Row="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Filter Parameter" />

                    <!-- Filter parameter combo -->
                    <ComboBox x:Name="FilterParamCombo"
                              Grid.Row="2" />

                    <!-- Value label -->
                    <TextBlock Grid.Row="4"
                               Style="{StaticResource FieldLabel}"
                               Margin="0"
                               VerticalAlignment="Center"
                               Text="Value" />

                    <!-- Apply + Clear buttons on same row as Value label -->
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="ApplyFilterButton"
                                Content="Apply"
                                Height="28"
                                Padding="12,0" />
                        <Button x:Name="ClearFilterButton"
                                Content="Clear"
                                Height="28"
                                Padding="12,0"
                                Margin="6,0,0,0" />
                    </StackPanel>

                    <!-- Value list -->
                    <ListBox x:Name="FilterValueList"
                             Grid.Row="6"
                             SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <!-- Search label -->
                    <TextBlock Grid.Row="8"
                               Style="{StaticResource FieldLabel}"
                               Text="Search" />

                    <!-- Search box -->
                    <TextBox x:Name="SearchBox"
                             Grid.Row="10" />

                    <!-- Select All / None / Invert -->
                    <WrapPanel Grid.Row="12" Orientation="Horizontal">
                        <Button x:Name="SelectAllButton"
                                Content="Select All"
                                Margin="0,0,6,6" />
                        <Button x:Name="SelectNoneButton"
                                Content="None"
                                Margin="0,0,6,6" />
                        <Button x:Name="InvertButton"
                                Content="Invert"
                                Margin="0,0,0,6" />
                    </WrapPanel>

                    <!-- Count label -->
                    <TextBlock x:Name="CountLabel"
                               Grid.Row="14"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="16"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE" />

            <!-- RIGHT: available + to-delete lists -->
            <Border Grid.Column="2" Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Available sheets -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionHeader}"
                                   Text="Available Sheets" />
                        <ListBox x:Name="AvailableList"
                                 Grid.Row="2"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <!-- Sheets to delete (read-only preview) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="0" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{StaticResource SectionHeader}"
                                   Text="Sheets To Delete" />
                        <ListBox x:Name="PreviewList"
                                 Grid.Row="2"
                                 Background="{StaticResource SurfaceBrush}"
                                 Foreground="{StaticResource MutedBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ValidationText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RefreshButton"
                        Content="Refresh"
                        MinWidth="90"
                        Margin="0,0,8,0" />
                <Button x:Name="DeleteButton"
                        Content="Delete Selected"
                        MinWidth="140"
                        Style="{StaticResource DestructiveButton}"
                        Margin="0,0,8,0" />
                <Button x:Name="CloseButton"
                        Content="Close"
                        MinWidth="90" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
