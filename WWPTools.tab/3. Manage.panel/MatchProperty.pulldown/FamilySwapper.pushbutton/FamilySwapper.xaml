<!--
  Loaded by pyRevit forms.WPFWindow (a Window subclass), so the theme's implicit Window style
  does not reach it: the root sets the page brush, text colour and type explicitly. The script
  merges the WWPTools theme into this window after pyRevit's own Theme.xaml so the theme's
  implicit control styles win here too.

  TypeGrid / ParamGrid are mapping tables: source columns sit in the Blue (input) lane, target
  columns in the Green (output) lane. The script addresses Columns[0] / Columns[1] by index, so
  the lane spacer is declared last and moved between the lanes with DisplayIndex.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Swapper"
        Width="580" Height="820"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        FontSize="13.5">

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="136"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Family Swapper" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Replace a titleblock family across sheets and remap instance parameters."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Scrollable config -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Families -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Families" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Source:" Style="{StaticResource FieldLabel}"
                                       Margin="0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SourceFamilyCmb"
                                      Grid.Column="1" Grid.ColumnSpan="2"
                                      ToolTip="Auto-detected from current selection -- change to override"/>
                            <TextBlock Grid.Row="2" Text="Target:" Style="{StaticResource FieldLabel}"
                                       Margin="0" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TargetFamilyCmb"
                                      Grid.Row="2" Grid.Column="1"
                                      ToolTip="Family to swap to"/>
                            <Button x:Name="SetTargetBtn"
                                    Grid.Row="2" Grid.Column="2"
                                    Content="Set target"
                                    Margin="8,0,0,0"
                                    ToolTip="Discover parameters from the selected target family"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Type Mapping -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Type mapping" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                        <TextBlock Text="Each source type maps to a target type."
                                   Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                        <DataGrid x:Name="TypeGrid" MinHeight="64" MaxHeight="180" Margin="0,0,0,10"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Source type"
                                    SelectedValueBinding="{Binding SourceType, UpdateSourceTrigger=LostFocus}"
                                    HeaderStyle="{StaticResource LaneBlueHeader}"
                                    CellStyle="{StaticResource LaneBlueCell}"
                                    Width="*"/>
                                <DataGridComboBoxColumn Header="Target type"
                                    SelectedValueBinding="{Binding TargetType, UpdateSourceTrigger=LostFocus}"
                                    HeaderStyle="{StaticResource LaneGreenHeader}"
                                    CellStyle="{StaticResource LaneGreenCell}"
                                    Width="*"/>
                                <DataGridTemplateColumn Width="6" DisplayIndex="1" CanUserResize="False"
                                    HeaderStyle="{StaticResource LaneGapHeader}"
                                    CellStyle="{StaticResource LaneGapCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddTypeRowBtn"  Content="+ Add row"         Margin="0,0,8,0"/>
                            <Button x:Name="RemTypeRowBtn"  Content="&#8722; Remove selected"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Parameter Mapping -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Parameter mapping" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                                   Text="Map old parameter names to new names. Leave target blank to keep the same name. Click Discover to populate dropdowns from the project."/>
                        <DataGrid x:Name="ParamGrid" MinHeight="64" MaxHeight="200" Margin="0,0,0,10"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridComboBoxColumn Header="Source parameter"
                                    SelectedValueBinding="{Binding OldName, UpdateSourceTrigger=LostFocus}"
                                    HeaderStyle="{StaticResource LaneBlueHeader}"
                                    CellStyle="{StaticResource LaneBlueCell}"
                                    Width="*">
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEditable" Value="True"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridComboBoxColumn Header="Target parameter"
                                    SelectedValueBinding="{Binding NewName, UpdateSourceTrigger=LostFocus}"
                                    HeaderStyle="{StaticResource LaneGreenHeader}"
                                    CellStyle="{StaticResource LaneGreenCell}"
                                    Width="*">
                                    <DataGridComboBoxColumn.EditingElementStyle>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEditable" Value="True"/>
                                        </Style>
                                    </DataGridComboBoxColumn.EditingElementStyle>
                                </DataGridComboBoxColumn>
                                <DataGridTemplateColumn Width="6" DisplayIndex="1" CanUserResize="False"
                                    HeaderStyle="{StaticResource LaneGapHeader}"
                                    CellStyle="{StaticResource LaneGapCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DiscoverBtn"    Content="Discover from project" Margin="0,0,8,0"/>
                            <Button x:Name="AddParamRowBtn" Content="+ Add row"             Margin="0,0,8,0"/>
                            <Button x:Name="RemParamRowBtn" Content="&#8722; Remove selected"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource WwpCard}">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="88"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Shift X (mm)  &#xB7;  + = right" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ShiftXBox" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Shift Y (mm)  &#xB7;  + = up" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ShiftYBox" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Batch size" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="BatchSizeBox" Text="40"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Log (read-only well) -->
        <TextBox Grid.Row="2"
                 x:Name="LogBox"
                 Margin="0,16,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 FontFamily="Consolas" FontSize="12"
                 Padding="10,8"/>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
            <Button DockPanel.Dock="Right"
                    x:Name="RunBtn"
                    Content="Run swap"
                    MinWidth="120"
                    Style="{StaticResource PrimaryButton}"/>
        </DockPanel>

    </Grid>
</Window>
