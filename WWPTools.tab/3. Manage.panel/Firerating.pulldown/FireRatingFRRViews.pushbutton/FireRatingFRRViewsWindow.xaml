<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Fire Rating Lines — FRR Views"
    Width="580" Height="640"
    MinWidth="480" MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Create Fire Rating Lines — All FRR Views" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Select views to process. Views with &#39;FRR&#39; in their name are listed."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- FRR Param -->
        <Border Grid.Row="1" Style="{StaticResource WwpCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="FRR Parameter Name:"
                           Style="{StaticResource FieldLabel}"
                           Margin="0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtFrrParam"/>
            </Grid>
        </Border>

        <!-- Views -->
        <Border Grid.Row="2" Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Select/Deselect buttons -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnSelectAll" Content="Select All"
                            MinWidth="90" Margin="0,0,8,0"/>
                    <Button x:Name="BtnDeselectAll" Content="Deselect All"
                            MinWidth="90"/>
                </StackPanel>

                <!-- View list -->
                <ListBox Grid.Row="1" x:Name="LstViews"
                         SelectionMode="Multiple"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" x:Name="LblStatus"
                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Margin="0,0,8,0"/>
                <Button x:Name="BtnRun" Content="Create Lines" MinWidth="110"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
