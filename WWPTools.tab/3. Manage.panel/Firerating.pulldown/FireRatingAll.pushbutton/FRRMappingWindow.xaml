<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Map FRR Values to Line Styles"
    Width="560" Height="460"
    MinWidth="460" MinHeight="380"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Map FRR Values to Line Styles" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="No matching line style was found for the values below. Select a line style for each, or choose &#x2014; Skip &#x2014; to ignore those walls."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Mapping table: header row here, one TableRow per FRR value filled from Python -->
        <Border Grid.Row="1" Style="{StaticResource WwpCard}" Padding="20,12,20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FRR value" Style="{StaticResource TableHeader}"/>
                    <TextBlock Grid.Column="1" Text="Line style" Style="{StaticResource TableHeader}" Margin="6,0,0,0"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MappingPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2" x:Name="LblStatus"
                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Margin="0,0,8,0"/>
                <Button x:Name="BtnOK" Content="Apply" MinWidth="90"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
