<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Create Fire Rating Lines"
    Width="540" Height="350"
    MinWidth="460" MinHeight="320"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Create Fire Rating Lines" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Draws detail lines along wall centerlines based on the FRR parameter value. If a line style is not found automatically, a mapping dialog will appear."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
            <StackPanel>
                <!-- FRR Param -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FRR Instance Parameter:"
                               Style="{StaticResource FieldLabel}"
                               Margin="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TxtFrrParam"
                             ToolTip="The instance parameter name on walls that stores the FRR rating (e.g. FRR, FRR Walls)"/>
                </Grid>

                <!-- Wall count -->
                <TextBlock x:Name="LblWallCount"
                           Style="{StaticResource CaptionText}" Margin="180,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2" x:Name="LblStatus"
                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Margin="0,0,8,0"/>
                <Button x:Name="BtnRun" Content="Create Lines" MinWidth="110"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
