<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parking Layout Solver"
        Width="560"
        Height="780"
        MinWidth="480"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>

        <!-- The shared theme has no Slider style: a Fluent slider built from theme brushes
             (accent fill left of the thumb, neutral track right of it). -->
        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="{StaticResource PanelBrush}" Stroke="{StaticResource BorderBrush}" StrokeThickness="1"/>
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource AccentBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="12"/>
                                <Setter TargetName="Dot" Property="Height" Value="12"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Dot" Property="Width" Value="8"/>
                                <Setter TargetName="Dot" Property="Height" Value="8"/>
                                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentPressBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource SliderTrackButton}"
                                              Background="{StaticResource AccentBrush}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource SliderTrackButton}"
                                              Background="{StaticResource StrongBorderBrush}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unit suffix beside a value box (m, deg, #). -->
        <Style x:Key="UnitText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Parking Layout Solver" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Pick a Room or Area boundary, configure spot types and layout, then Generate."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- ROOM INFO CARD -->
        <Border Grid.Row="1" Style="{StaticResource WwpCard}" Padding="20,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Boundary room / area" Style="{StaticResource CaptionText}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="RoomNameText"
                               Text="-"
                               Style="{StaticResource StatValue}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="Gross area" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Right" Margin="0,0,0,2"/>
                    <TextBlock x:Name="RoomAreaText"
                               Text="-"
                               Style="{StaticResource StatValue}"
                               HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SCROLLABLE CONTENT -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- SPOT TYPES CARD -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <StackPanel>

                        <!-- Header row with Add button -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Parking spot types"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="AddRowButton"
                                    Grid.Column="1"
                                    Content="+ Add Row"/>
                        </Grid>

                        <!-- Column labels (match the Python-built row grid: *, *, 64, 26) -->
                        <Grid Margin="9,0,9,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="26"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Family" Style="{StaticResource TableHeader}"/>
                            <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource TableHeader}"/>
                            <TextBlock Grid.Column="2" Text="Count" Style="{StaticResource TableNumberHeader}"
                                       Margin="0,0,5,0"/>
                        </Grid>

                        <!-- Dynamic rows - populated by Python -->
                        <StackPanel x:Name="RowsPanel"/>

                        <TextBlock Text="Count 0 = fill all remaining available positions."
                                   Style="{StaticResource CaptionText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DIMENSIONS CARD -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <StackPanel>

                        <TextBlock Text="Spot dimensions" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                        <!-- Stall width -->
                        <TextBlock Text="Stall width" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="StallWidthSlider" Grid.Column="0"
                                    Minimum="2.2" Maximum="3.5" Value="2.5"
                                    SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="StallWidthText" Grid.Column="1"
                                     Text="2.5" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="m" Style="{StaticResource UnitText}"/>
                        </Grid>

                        <!-- Stall depth -->
                        <TextBlock Text="Stall depth (length)" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="StallDepthSlider" Grid.Column="0"
                                    Minimum="4.5" Maximum="6.5" Value="5.0"
                                    SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="StallDepthText" Grid.Column="1"
                                     Text="5.0" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="m" Style="{StaticResource UnitText}"/>
                        </Grid>

                        <!-- Road / aisle width -->
                        <TextBlock Text="Road width (drive aisle)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="AisleWidthSlider" Grid.Column="0"
                                    Minimum="5.0" Maximum="9.0" Value="6.5"
                                    SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="AisleWidthText" Grid.Column="1"
                                     Text="6.5" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="m" Style="{StaticResource UnitText}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- PLOT SETTINGS CARD -->
                <Border Style="{StaticResource WwpCard}">
                    <StackPanel>

                        <TextBlock Text="Plot settings" Style="{StaticResource SectionHeader}" Margin="0,0,0,12"/>

                        <!-- Skirt -->
                        <TextBlock Text="Skirt - inner boundary tolerance" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SkirtSlider" Grid.Column="0"
                                    Minimum="0.0" Maximum="2.0" Value="0.5"
                                    SmallChange="0.1" LargeChange="0.5" IsSnapToTickEnabled="True" TickFrequency="0.1"
                                    VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="SkirtText" Grid.Column="1"
                                     Text="0.5" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="m" Style="{StaticResource UnitText}"/>
                        </Grid>

                        <!-- Perimetral mode -->
                        <TextBlock Text="Perimetral spots" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PerimetralCombo" Margin="0,0,0,12"/>

                        <!-- Rotation offset -->
                        <TextBlock Text="Rotation offset" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Adjust if stalls face the wrong direction after generate."
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="RotationText" Grid.Column="1"
                                     Text="0" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="deg" Style="{StaticResource UnitText}"/>
                        </Grid>

                        <!-- Max run -->
                        <TextBlock Text="Max run stall count" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Max stalls before a mid-row gap. 0 = no limit."
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="MaxRunText" Grid.Column="1"
                                     Text="0" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="#" Style="{StaticResource UnitText}"/>
                        </Grid>

                        <!-- Max run gap width -->
                        <TextBlock Text="Max run gap width" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Gap between runs (e.g. 0.5 m every N stalls)."
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="MaxRunGapText" Grid.Column="1"
                                     Text="0.5" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="m" Style="{StaticResource UnitText}"/>
                        </Grid>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status row -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="Ready. Configure settings and click Generate."
                           Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StallCountText"
                           Grid.Column="1"
                           Text=""
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>

            <!-- Button row -->
            <DockPanel Grid.Row="1" LastChildFill="False">
                <Image x:Name="LogoImage" Style="{StaticResource BrandLogoCompact}"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button x:Name="ClearButton"
                            Content="Clear Stalls"
                            MinWidth="100" Margin="0,0,8,0"/>
                    <Button x:Name="GenerateButton"
                            Content="Generate"
                            MinWidth="110" Margin="0,0,8,0"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="CloseButton"
                            Content="Close"
                            MinWidth="80"/>
                </StackPanel>
            </DockPanel>
        </Grid>

    </Grid>
</Window>
