<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parking Count in Room/Area"
        Height="680"
        Width="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Parking Count in Room/Area" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Select rooms/areas with parking" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Three-column main area -->
        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                </Grid.ColumnDefinitions>

                <!-- Column 0: Spaces list -->
                <DockPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Rooms / areas"
                               Style="{StaticResource SectionHeader}"/>
                    <ListBox Name="RoomsList" SelectionMode="Extended"/>
                </DockPanel>

                <!-- Column 1: Families list -->
                <DockPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Parking families to include"
                               Style="{StaticResource SectionHeader}"/>
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Name="AddFamilyText"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"/>
                        <Button Name="AddFamilyButton"
                                Grid.Column="1"
                                Content="+ Add"/>
                    </Grid>
                    <ListBox Name="FamiliesList" SelectionMode="Extended"/>
                </DockPanel>

                <!-- Column 2: Options -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Target text parameter to write"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox Name="RoomParamCombo" Margin="0,0,0,16"/>

                    <TextBlock Text="Parking count source"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox Name="CountParamCombo" Margin="0,0,0,16"/>

                    <CheckBox Name="BreakdownCheckBox"
                              Content="Include parking type breakdowns"
                              Margin="0,0,0,12"/>

                    <TextBlock Name="TypeSourceLabel"
                               Text="Type parameter"
                               Style="{StaticResource FieldLabel}"
                               Visibility="Collapsed"/>
                    <ComboBox Name="TypeSourceCombo"
                              Margin="0,0,0,0"
                              Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Style="{StaticResource WwpFooter}">
            <Image Name="LogoImage"
                   Style="{StaticResource BrandLogoFooter}"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Name="OkButton"
                        Content="Run"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"/>
                <Button Name="CancelButton"
                        Content="Cancel"
                        MinWidth="110"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
