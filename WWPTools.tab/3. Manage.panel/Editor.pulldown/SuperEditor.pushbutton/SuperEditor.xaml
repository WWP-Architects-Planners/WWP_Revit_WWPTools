<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Super Editor"
        Width="540"
        Height="850"
        MinWidth="440"
        MinHeight="700"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WWPTools.WpfUI;component/Themes/FlatTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Labels beside inputs: the theme's FieldLabel look (the theme has no Label style). -->
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0  header -->
            <RowDefinition Height="Auto" />   <!-- 1  rename type + category + source -->
            <RowDefinition Height="Auto" />   <!-- 2  param panel (Collapsed) -->
            <RowDefinition Height="Auto" />   <!-- 3  operation panel + options -->
            <RowDefinition Height="*" />      <!-- 4  flex -->
            <RowDefinition Height="Auto" />   <!-- 5  footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtHeader"
                       Text="Super Editor"
                       Style="{StaticResource PageTitle}" />
            <TextBlock x:Name="TxtSubtitle"
                       Text="Find and replace names across your project."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Rename type / category / scope -->
        <Border Grid.Row="1" Style="{StaticResource WwpCard}" Padding="16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label x:Name="LblTarget" Grid.Column="0" Content="Rename:" />
                    <ComboBox x:Name="CmbTarget" Grid.Column="1" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label x:Name="LblSelector" Grid.Column="0" Content="Category:" />
                    <ComboBox x:Name="CmbCategory" Grid.Column="1" />
                </Grid>
                <!-- Source label -->
                <TextBlock x:Name="TxtSource"
                           Margin="80,8,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="Source: All elements in document" />
            </StackPanel>
        </Border>

        <!-- Parameters panel (shown after Load) -->
        <Border x:Name="PnlParameters"
                Grid.Row="2"
                Visibility="Collapsed"
                Style="{StaticResource WwpCard}"
                Padding="16,12"
                Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="Parameters"
                           Style="{StaticResource SectionHeader}"
                           Margin="0,0,0,4" />
                <ListBox x:Name="LstParameters"
                         Grid.Row="1"
                         Height="172"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0" />
            </Grid>
        </Border>

        <!-- Operation panel -->
        <Border Grid.Row="3" Style="{StaticResource WwpCard}" Padding="16" Margin="0,12,0,0">
            <StackPanel>

                <!-- Mode: Transform vs Overwrite -->
                <StackPanel x:Name="PnlModeToggle" Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RbTransform"
                                 Content="Transform"
                                 IsChecked="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,20,0" />
                    <RadioButton x:Name="RbOverwrite"
                                 Content="Overwrite"
                                 VerticalAlignment="Center" />
                </StackPanel>

                <!-- Transform: Find / Replace / Prefix / Suffix -->
                <Grid x:Name="PnlTransform">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Find:" />
                    <TextBox x:Name="TxtFind" Grid.Row="0" Grid.Column="1" />

                    <Label Grid.Row="2" Grid.Column="0" Content="Replace:" />
                    <TextBox x:Name="TxtReplace" Grid.Row="2" Grid.Column="1" />

                    <Label Grid.Row="4" Grid.Column="0" Content="Prefix:" />
                    <TextBox x:Name="TxtPrefix" Grid.Row="4" Grid.Column="1" />

                    <Label Grid.Row="6" Grid.Column="0" Content="Suffix:" />
                    <TextBox x:Name="TxtSuffix" Grid.Row="6" Grid.Column="1" />
                </Grid>

                <!-- Overwrite: single value field -->
                <Grid x:Name="PnlOverwrite" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Set to:" />
                    <TextBox x:Name="TxtOverwrite" Grid.Column="1" />
                </Grid>

                <!-- Workset: target workset list -->
                <Border x:Name="PnlWorkset"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="Target workset"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0,0,0,6" />
                        <ListBox x:Name="LstWorksets"
                                 Grid.Row="1"
                                 Height="172" />
                    </Grid>
                </Border>

                <!-- Options checkboxes -->
                <StackPanel Orientation="Vertical" Margin="0,14,0,0">
                    <CheckBox x:Name="ChkIgnoreGroups"
                              IsChecked="True"
                              Content="Ignore elements in groups"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="ChkAlsoRenameFamily"
                              Visibility="Collapsed"
                              Content="Also rename family name"
                              Margin="0,8,0,0"
                              VerticalAlignment="Center" />
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="BtnCancel"
                        MinWidth="90"
                        Margin="0,0,8,0"
                        Content="Cancel"
                        IsCancel="True" />
                <Button x:Name="BtnApply"
                        MinWidth="150"
                        Content="Preview &amp; Apply"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
