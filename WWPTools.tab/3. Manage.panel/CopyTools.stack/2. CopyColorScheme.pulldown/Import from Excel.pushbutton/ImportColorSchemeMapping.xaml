<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Color Scheme"
        Width="960"
        Height="760"
        MinWidth="860"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource PageSubtitle}"
                   Margin="0,0,0,16"
                   Text="Select which Excel columns drive the color scheme value and color."/>

        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Worksheet" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="WorksheetCombo"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Value Column" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ValueColumnCombo"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Color Column" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ColorColumnCombo"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <CheckBox x:Name="UseCellFillCheck"
                              IsChecked="True"
                              Content="Use the cell fill color first, then fall back to the cell text (supports RGB / hex text)." />
                    <CheckBox x:Name="ColorOverrideCheck"
                              IsChecked="False"
                              Margin="0,10,0,0"
                              Content="Color override only — update existing entries only. Leave off to merge Excel rows into the scheme and create missing entries." />
                </StackPanel>
                <TextBlock x:Name="ValidationText"
                           Grid.Row="2"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="PreviewText"
                         Grid.Row="3"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="OkButton"
                        MinWidth="130"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="Use Mapping"/>
                <Button x:Name="CancelButton"
                        MinWidth="130"
                        Content="Cancel"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
