<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Copy Color Scheme"
        Width="720"
        Height="400"
        MinWidth="620"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WwpCard}">
            <StackPanel>
                <TextBlock Text="Source color scheme" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="SourceSchemeCombo" Margin="0,0,0,14"/>

                <TextBlock Text="Target color scheme" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TargetSchemeCombo" Margin="0,0,0,14"/>

                <TextBlock x:Name="ValidationText"
                           Foreground="{StaticResource DangerBrush}"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           FontWeight="SemiBold"/>

                <CheckBox x:Name="CreateNewSchemeCheck"
                          Margin="0,0,0,8"
                          Content="Create new scheme in target scope (leave selected target unchanged)" />

                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="26,0,0,0"
                           Text="Unchecked: overwrites the selected target scheme. Checked: creates a new scheme in the selected target scope and copies into it."/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="1" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="OkButton"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="OK"/>
                <Button x:Name="CancelButton"
                        MinWidth="110"
                        Content="Cancel"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
