<!--
  Import Area Key Schedule. Loaded by "Key Schedule-script.py" (_show_area_keyplan_import_dialog)
  after WWP_uiUtils.uiUtils_ensure_theme(), and preferred by WWP_uiUtils.uiUtils_area_keyplan_import;
  lib/AreaKeyplanImportWindow.xaml is the reduced fallback copy.

  MappingGrid (LIM table language): Blue lane = the Excel source column, Green lane = the Revit
  parameter it maps to. The Map To combos read their options from MappingGrid.Tag.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Key Schedule from Excel"
        Width="980"
        Height="780"
        MinHeight="640"
        MinWidth="820"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Text="Excel file" />
                    <TextBox x:Name="FilePathBox"
                             Grid.Column="1"
                             ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="2"
                            Content="Browse"
                            MinWidth="88"
                            Margin="8,0,0,0" />
                    <Button x:Name="LoadButton"
                            Grid.Column="3"
                            Content="Refresh"
                            ToolTip="Reread the saved Excel file and selected worksheet."
                            MinWidth="88"
                            Margin="8,0,0,0" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource FieldLabel}"
                               Text="Excel sheet" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource FieldLabel}"
                               Text="Target type" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="4"
                               Style="{StaticResource FieldLabel}"
                               Text="Key schedule" />

                    <ComboBox x:Name="SheetCombo"
                              Grid.Row="1"
                              Grid.Column="0"
                              ToolTip="Select a worksheet, then click Refresh to read its columns." />
                    <ComboBox x:Name="TargetTypeCombo"
                              Grid.Row="1"
                              Grid.Column="2" />
                    <!-- The key schedules of the Target Type already in the model, then "Add new...".
                         NewScheduleNameBox shows only for "Add new..." (the script sets the spans). -->
                    <Grid Grid.Row="1" Grid.Column="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ScheduleCombo"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  ToolTip="Update a key schedule of this type, or add a new one."
                                  AutomationProperties.Name="Key schedule" />
                        <TextBox x:Name="NewScheduleNameBox"
                                 Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Visibility="Collapsed"
                                 ToolTip="Name of the new key schedule. Starts as the Excel file name."
                                 AutomationProperties.Name="New key schedule name" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12"
                Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="{Binding ElementName=MappingGrid, Path=Items.Count, StringFormat={}{0} columns}" />
                    <TextBlock Style="{StaticResource PageTitle}"
                               Text="Column mapping" />
                </DockPanel>

                <Expander x:Name="SavedSetsExpander"
                          Grid.Row="1"
                          Header="Saved mapping sets"
                          IsExpanded="False"
                          HorizontalContentAlignment="Stretch"
                          Foreground="{StaticResource MutedBrush}"
                          Margin="0,0,0,10">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="Saved set" />
                        <ComboBox x:Name="SavedSetCombo"
                                  Grid.Column="1"
                                  IsEditable="True"
                                  Margin="0,0,8,0" />
                        <Button x:Name="LoadSetButton"
                                Grid.Column="2"
                                Content="Load"
                                MinWidth="64"
                                Margin="0,0,8,0" />
                        <Button x:Name="SaveSetButton"
                                Grid.Column="3"
                                Content="Save"
                                MinWidth="64"
                                Margin="0,0,8,0" />
                        <Button x:Name="DeleteSetButton"
                                Grid.Column="4"
                                Content="Delete"
                                MinWidth="64"
                                Margin="0,0,8,0" />
                        <Button x:Name="ExportSetButton"
                                Grid.Column="5"
                                Content="Export Setting"
                                Margin="0,0,8,0" />
                        <Button x:Name="ImportSetButton"
                                Grid.Column="6"
                                Content="Import Setting" />
                    </Grid>
                </Expander>

                <DataGrid x:Name="MappingGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="False"
                          HeadersVisibility="Column"
                          VirtualizingPanel.IsVirtualizing="False"
                          BorderThickness="0"
                          MinHeight="200">
                    <DataGrid.Resources>
                        <ControlTemplate x:Key="MappingCellTemplate" TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                        <Style x:Key="MappingSourceCell"
                               TargetType="DataGridCell"
                               BasedOn="{StaticResource LaneBlueCell}">
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="Template" Value="{StaticResource MappingCellTemplate}" />
                        </Style>
                        <Style x:Key="MappingParameterCell"
                               TargetType="DataGridCell"
                               BasedOn="{StaticResource LaneGreenCell}">
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="Template" Value="{StaticResource MappingCellTemplate}" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Excel Column"
                                            Binding="{Binding ColumnName}"
                                            IsReadOnly="True"
                                            HeaderStyle="{StaticResource LaneBlueHeader}"
                                            CellStyle="{StaticResource MappingSourceCell}"
                                            ElementStyle="{StaticResource TableCellText}"
                                            Width="2*" />
                        <DataGridTemplateColumn Width="6"
                                                HeaderStyle="{StaticResource LaneGapHeader}"
                                                CellStyle="{StaticResource LaneGapCell}"
                                                CanUserResize="False" />
                        <DataGridTemplateColumn Header="Map To"
                                                HeaderStyle="{StaticResource LaneGreenHeader}"
                                                CellStyle="{StaticResource MappingParameterCell}"
                                                Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding ElementName=MappingGrid, Path=Tag}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center"
                   Style="{StaticResource BrandLogoFooter}" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="88"
                        Margin="0,0,8,0" />
                <Button x:Name="OkButton"
                        Content="Import"
                        MinWidth="96"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
