<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Make Marketing View"
    Width="720" Height="720"
    MinWidth="560" MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Make Marketing View" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Create a cropped marketing view and sheet for each selected area."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Form body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <!-- Area and Door info -->
                <Border Style="{StaticResource WwpCard}" Padding="20,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Selected Area"
                                       Style="{StaticResource CaptionText}" Margin="0,0,0,2" />
                            <TextBlock x:Name="AreaLabel"
                                       Text="(not selected)"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Entry Door"
                                       Style="{StaticResource CaptionText}" Margin="0,0,0,2" />
                            <TextBlock x:Name="DoorLabel"
                                       Text="(not found)"
                                       FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sheet Settings -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="Sheet Settings" Style="{StaticResource SectionHeader}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Sheet Number Parameter:"
                                   Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SheetNumberParamCombo"
                                  Grid.Row="1" Grid.Column="1" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Sheet Name Parameter:"
                                   Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="SheetNameParamCombo"
                                  Grid.Row="3" Grid.Column="1" />
                    </Grid>
                </Border>

                <!-- View Settings -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="View Settings" Style="{StaticResource SectionHeader}" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="View Template:"
                                   Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="TemplateCombo"
                                  Grid.Row="1" Grid.Column="1" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Titleblock:"
                                   Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="TitleblockCombo"
                                  Grid.Row="3" Grid.Column="1" />
                    </Grid>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource WwpCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Options" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="OverwriteCheckBox"
                                  Content="Overwrite existing sheets with the same sheet number" />
                    </StackPanel>
                </Border>

                <!-- Keyplan -->
                <Border Style="{StaticResource WwpCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="Keyplan" Style="{StaticResource SectionHeader}" />

                        <CheckBox x:Name="KeyplanCheckBox"
                                  Grid.Row="1" Grid.ColumnSpan="2"
                                  Content="Create keyplan view alongside marketing view" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Keyplan Template:"
                                   Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="KeyplanTemplateCombo"
                                  Grid.Row="3" Grid.Column="1" />

                        <TextBlock Grid.Row="5" Grid.Column="0"
                                   Text="Fill Type:"
                                   Style="{StaticResource FieldLabel}" Margin="0"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="FillTypeCombo"
                                  Grid.Row="5" Grid.Column="1" />
                    </Grid>
                </Border>

                <!-- Validation text -->
                <TextBlock x:Name="ValidationText"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Content="Cancel" MinWidth="90"
                        Margin="0,0,8,0" />
                <Button x:Name="OkButton"
                        Content="Create" MinWidth="100"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
