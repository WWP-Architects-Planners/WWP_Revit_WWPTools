<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Make Keyplans"
    Width="540" Height="350"
    MinWidth="420" MinHeight="320"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Make Keyplans" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Create keyplan views with a filled region highlighting the selected suite area(s)."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Form -->
        <Border Grid.Row="2" Style="{StaticResource WwpCard}" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Area -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Selected Area:"
                           Style="{StaticResource FieldLabel}" Margin="0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="AreaLabel"
                           Grid.Row="0" Grid.Column="1"
                           Text="(not selected)"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />

                <!-- Keyplan Template -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Keyplan Template:"
                           Style="{StaticResource FieldLabel}" Margin="0"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="TemplateCombo"
                          Grid.Row="2" Grid.Column="1" />

                <!-- Fill Type -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Fill Type:"
                           Style="{StaticResource FieldLabel}" Margin="0"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="FillTypeCombo"
                          Grid.Row="4" Grid.Column="1" />

                <!-- Validation -->
                <TextBlock x:Name="ValidationText"
                           Grid.Row="5" Grid.ColumnSpan="2"
                           Margin="0,10,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OkButton"
                        Content="Create" MinWidth="100"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0" />
                <Button x:Name="CancelButton"
                        Content="Cancel" MinWidth="90" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
