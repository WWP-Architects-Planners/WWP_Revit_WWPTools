<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Publish Fire Rating to Doors"
    Width="520" Height="350"
    MinWidth="440" MinHeight="320"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Publish Fire Rating to Doors" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Copies FRR and STC parameter values from host walls to doors."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <!-- Parameters -->
        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="FRR Parameter Name:"
                           Style="{StaticResource FieldLabel}"
                           Margin="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtFrrParam"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="STC Parameter Name:"
                           Style="{StaticResource FieldLabel}"
                           Margin="0" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtStcParam"/>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2" x:Name="LblStatus"
                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Margin="0,0,8,0"/>
                <Button x:Name="BtnRun" Content="Publish" MinWidth="90"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
