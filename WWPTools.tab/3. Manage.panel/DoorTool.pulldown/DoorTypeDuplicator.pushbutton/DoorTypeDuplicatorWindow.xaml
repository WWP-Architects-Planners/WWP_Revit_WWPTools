<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Door Type Duplicator"
    Width="580" Height="620"
    MinWidth="480" MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Door Type Duplicator" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Select a door type to duplicate, then enter a name for the new type."
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Door type list -->
                <ListBox Grid.Row="0" x:Name="LstDoorTypes"
                         Margin="0,0,0,14"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>

                <!-- New name -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="New Type Name:"
                               Style="{StaticResource FieldLabel}"
                               Margin="0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" x:Name="TxtNewName"/>
                </Grid>

                <!-- Custom size toggle -->
                <CheckBox Grid.Row="2" x:Name="ChkCustomSize"
                          Content="Set custom dimensions (mm)"
                          Margin="0,0,0,8"/>

                <!-- Custom size panel -->
                <StackPanel Grid.Row="3" x:Name="PnlCustomSize" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Width (mm):"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="TxtWidth"/>
                        <TextBlock Grid.Column="2"/>
                        <TextBlock Grid.Column="3" Text="Height (mm):"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="4" x:Name="TxtHeight"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2" x:Name="LblStatus"
                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap"/>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   Style="{StaticResource BrandLogoFooter}"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="Cancel" MinWidth="90" Margin="0,0,8,0"/>
                <Button x:Name="BtnDuplicate" Content="Duplicate" MinWidth="100"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
