<!--
  Bulk Import Shared Parameters. Loaded by BulkImportSharedParameters-script.py through
  pyRevit forms.WPFWindow after WWP_uiUtils.uiUtils_ensure_theme(), so every brush and style
  here comes from lib/FlatTheme.xaml.

  ParameterGrid (LIM table language): the Blue lane holds what is being imported (parameter and
  its binding), the Amber lane holds the read-only import notes. The script reads
  ParameterGrid.Columns[0..3] by index, so the lane spacer sits after Category. The lane
  columns have fixed widths: star widths leave 1px seams inside a lane wash.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Import Shared Parameters"
        Width="1180"
        Height="760"
        MinWidth="820"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <!-- Editing combo inside a grid cell: theme look, compact enough for the row, no free text. -->
        <Style x:Key="GridComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="IsEditable" Value="False"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Bulk Import Shared Parameters"
                       Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Create rows manually or import them from Excel. Every imported row remains editable before anything is added to Revit."/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Padding="20,14"
                Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Text="Shared Parameters file"/>
                <TextBox x:Name="SharedFileBox"
                         Grid.Column="1"
                         IsReadOnly="True"/>
                <Button x:Name="BrowseButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="Choose another..."/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionHeader}"
                               Text="Parameter bindings"/>
                    <TextBlock x:Name="ParameterCountText"
                               Grid.Column="1"
                               Style="{StaticResource CaptionText}"/>
                </Grid>

                <DataGrid x:Name="ParameterGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          MinRowHeight="38"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="Shared parameter"
                                                SelectedValueBinding="{Binding Parameter, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                HeaderStyle="{StaticResource LaneBlueHeader}"
                                                CellStyle="{StaticResource LaneBlueCell}"
                                                Width="300"/>
                        <DataGridComboBoxColumn Header="Instance / Type"
                                                SelectedValueBinding="{Binding Binding, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                HeaderStyle="{StaticResource LaneBlueHeader}"
                                                CellStyle="{StaticResource LaneBlueCell}"
                                                Width="120"/>
                        <DataGridComboBoxColumn Header="Parameter group"
                                                SelectedValueBinding="{Binding Group, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                HeaderStyle="{StaticResource LaneBlueHeader}"
                                                CellStyle="{StaticResource LaneBlueCell}"
                                                Width="200"/>
                        <DataGridComboBoxColumn Header="Category"
                                                SelectedValueBinding="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                                EditingElementStyle="{StaticResource GridComboStyle}"
                                                HeaderStyle="{StaticResource LaneBlueHeader}"
                                                CellStyle="{StaticResource LaneBlueCell}"
                                                Width="200"/>
                        <DataGridTemplateColumn Width="6"
                                                HeaderStyle="{StaticResource LaneGapHeader}"
                                                CellStyle="{StaticResource LaneGapCell}"
                                                CanUserResize="False"/>
                        <DataGridTextColumn Header="Import notes"
                                            Binding="{Binding ImportNotes}"
                                            IsReadOnly="True"
                                            HeaderStyle="{StaticResource LaneAmberHeader}"
                                            CellStyle="{StaticResource LaneAmberCell}"
                                            ElementStyle="{StaticResource TableCellText}"
                                            Width="*"
                                            MinWidth="180"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        Margin="0,12,0,0"
                        Style="{StaticResource WwpInset}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Bulk edit selected rows"/>
                            <TextBlock Margin="10,0,0,0"
                                       Style="{StaticResource MutedText}"
                                       Text="Ctrl/Shift-click rows in the table, then choose one value to apply."/>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource MutedText}"
                                       Text="Field"/>
                            <ComboBox x:Name="BulkFieldCombo"
                                      Grid.Column="1"
                                      Margin="0,0,16,0"
                                      AutomationProperties.Name="Bulk edit field"/>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource MutedText}"
                                       Text="Value"/>
                            <ComboBox x:Name="BulkValueCombo"
                                      Grid.Column="3"
                                      Margin="0,0,16,0"
                                      IsTextSearchEnabled="True"
                                      AutomationProperties.Name="Bulk edit value"/>
                            <CheckBox x:Name="OnlyMissingCheckBox"
                                      Grid.Column="4"
                                      VerticalAlignment="Center"
                                      Margin="0,0,16,0"
                                      IsChecked="True"
                                      Content="Only fill missing values"/>
                            <Button x:Name="ApplySelectedButton"
                                    Grid.Column="5"
                                    Content="Apply to selected"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="ExcelImportButton" Content="Import rows from Excel..." Margin="0,0,8,0"/>
                    <Button x:Name="AddParametersButton"
                            Content="+ Add parameters..."
                            Margin="0,0,8,0"
                            ToolTip="Choose several shared parameters at once and add one selected row for each."/>
                    <Button x:Name="AddRowButton" Content="+ Add row" Margin="0,0,8,0"/>
                    <Button x:Name="DuplicateRowButton" Content="Duplicate selected" Margin="0,0,8,0"/>
                    <Button x:Name="RemoveRowButton" Content="Remove selected"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="2,12,2,0"
                   Style="{StaticResource MutedText}"
                   Text="Excel rows are editable. Existing bindings keep their current categories; selected categories are added."/>

        <DockPanel Grid.Row="4" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center"
                   Style="{StaticResource BrandLogoFooter}"/>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="88" Margin="0,0,8,0"/>
                <Button x:Name="ImportButton"
                        Content="Import parameters"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
