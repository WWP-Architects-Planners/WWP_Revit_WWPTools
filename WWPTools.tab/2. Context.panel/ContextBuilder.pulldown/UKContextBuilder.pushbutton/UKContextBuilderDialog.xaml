<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UK Context Builder"
        Height="780"
        Width="1060"
        MinHeight="720"
        MinWidth="820"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="UK Context Builder"
                       Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}">
                Imports UK context from OSM with EA terrain support for terrain and missing building heights.
            </TextBlock>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource WwpCard}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Address"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AddressTextBox"/>
                                <Button x:Name="LocateButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        MinWidth="84"
                                        Content="Locate"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Radius (m)"/>
                            <TextBox x:Name="RadiusTextBox"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="Dense Area (m)"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DenseAreaTextBox"/>
                                <CheckBox x:Name="UseDenseAreaCheckBox"
                                          Grid.Column="1"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          Content="Use Dense Center"/>
                            </Grid>
                        </StackPanel>

                        <TextBlock Grid.Row="3"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,0,12"
                                   Style="{StaticResource CaptionText}">
                            Leave Address blank to use the project site location when available. Click the map to set a location and reverse-geocode it back into the address field.
                        </TextBlock>

                        <Button x:Name="UseRevitLocationButton"
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource OutlineButton}"
                                Foreground="{StaticResource AccentBrush}"
                                Visibility="Collapsed"
                                Content="Use Revit Geo-Reference Location"/>

                        <Grid Grid.Row="5"
                              Grid.ColumnSpan="2"
                              Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Width probe so the long label wraps beside the check box. -->
                            <Border x:Name="FastModeLabelWidth"
                                    Grid.Column="1"
                                    Visibility="Hidden"/>
                            <CheckBox x:Name="FastModeCheckBox"
                                      Grid.ColumnSpan="2"
                                      IsChecked="False">
                                <TextBlock TextWrapping="Wrap"
                                           MaxWidth="{Binding ActualWidth, ElementName=FastModeLabelWidth}"
                                           Text="Fast Mode (coarse terrain only, skip DSM-DTM height fallback)"/>
                            </CheckBox>
                        </Grid>

                        <StackPanel Grid.Row="6"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="Layers"/>
                            <WrapPanel>
                                <CheckBox x:Name="BuildingsCheckBox"
                                          Margin="0,0,18,8"
                                          IsChecked="True"
                                          Content="Buildings"/>
                                <CheckBox x:Name="RoadsCheckBox"
                                          Margin="0,0,18,8"
                                          IsChecked="True"
                                          Content="Roads"/>
                                <CheckBox x:Name="TracksCheckBox"
                                          Margin="0,0,18,8"
                                          IsChecked="True"
                                          Content="Tracks"/>
                                <CheckBox x:Name="ParcelsCheckBox"
                                          Margin="0,0,18,8"
                                          IsChecked="False"
                                          Content="Parcels"/>
                                <CheckBox x:Name="ParksCheckBox"
                                          Margin="0,0,18,8"
                                          IsChecked="True"
                                          Content="Parks"/>
                                <CheckBox x:Name="WaterCheckBox"
                                          Margin="0,0,18,8"
                                          IsChecked="True"
                                          Content="Water"/>
                                <CheckBox x:Name="TerrainCheckBox"
                                          Margin="0,0,18,8"
                                          IsChecked="False"
                                          Content="Terrain"/>
                            </WrapPanel>
                        </StackPanel>

                        <Border Grid.Row="7"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource WwpInset}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,6"
                                           Text="Automatic Outputs"/>
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Text="Buildings -> DirectShape&#x0a;Missing building heights -> DSM minus DTM fallback&#x0a;Roads, Tracks, Parcels, Parks, Water -> Floors or terrain subdivisions&#x0a;Terrain -> Toposolid from UK EA DTM"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ValidationText"
                                   Grid.Row="8"
                                   Grid.ColumnSpan="2"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="16"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="Transparent"
                          ShowsPreview="True"/>

            <Border Grid.Column="2"
                    Style="{StaticResource WwpCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left"
                                   Style="{StaticResource SectionHeader}"
                                   Margin="0"
                                   Text="Map Preview"/>
                        <TextBlock x:Name="MapHintText"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="Click map to choose the import center."/>
                    </DockPanel>
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <WebBrowser x:Name="MapBrowser"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center"
                   Style="{StaticResource BrandLogoFooter}"/>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="DryRunButton"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Content="Dry Run"/>
                <Button x:Name="RunButton"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="Run"/>
                <Button x:Name="CancelButton"
                        MinWidth="96"
                        Content="Cancel"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
