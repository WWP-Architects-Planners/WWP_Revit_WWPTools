<!--
  Publish Mass Level Counts: destination-parameter mapping. Loaded by
  massidtool_core.show_publish_mapping_dialog() after uiUtils_ensure_theme(); it sets
  SizeToContent=Height, fills the three combos and wires OkButton / CancelButton.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Publish Mass Level Counts"
        Width="520"
        Height="430"
        MinWidth="480"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="{StaticResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Publish Mass metrics"
                   Style="{StaticResource PageTitle}"/>

        <TextBlock Grid.Row="1"
                   Style="{StaticResource PageSubtitle}"
                   Text="Map the destination Mass instance parameters for typical floor area, included levels, and highest level. Highest level is written as the sorted project level index for each mass's tallest associated Mass Floor."/>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Style="{StaticResource WwpCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Style="{StaticResource FieldLabel}"
                           Text="Mass Typical Floor Area"/>
                <ComboBox x:Name="AreaParamCombo"
                          Grid.Row="0"
                          Grid.Column="1"
                          Margin="0,0,0,12"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,12,12"
                           VerticalAlignment="Center"
                           Style="{StaticResource FieldLabel}"
                           Text="Mass Included Levels"/>
                <ComboBox x:Name="CountParamCombo"
                          Grid.Row="1"
                          Grid.Column="1"
                          Margin="0,0,0,12"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource FieldLabel}"
                           Text="Mass Highest Level"/>
                <ComboBox x:Name="HighestLevelParamCombo"
                          Grid.Row="2"
                          Grid.Column="1"/>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Style="{StaticResource WwpFooter}">
            <Image x:Name="LogoImage"
                   DockPanel.Dock="Left"
                   VerticalAlignment="Center"
                   Style="{StaticResource BrandLogoFooter}"/>
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        MinWidth="88"
                        Margin="0,0,8,0"/>
                <Button x:Name="OkButton"
                        Content="Publish"
                        MinWidth="96"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
