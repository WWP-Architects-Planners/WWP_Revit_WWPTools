<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WWPTools"
        Height="395"
        Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        KeyDown="handleclick"
        MouseDown="handleclick">
    <Window.Resources>
        <!-- Small pill for the version / branch / commit facts. -->
        <Style x:Key="AboutBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Window.Resources>

    <!-- The card is the whole window; the outer margin leaves room for the shadow. -->
    <Border Margin="18"
            Style="{StaticResource WwpCard}"
            Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.16" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="190"
                    Height="190"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource AccentSoftBrush}"
                    CornerRadius="16">
                <Image x:Name="LogoImage" Style="{StaticResource BrandLogoHero}"
                       Margin="24" />
            </Border>

            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock x:Name="TitleText"
                           Style="{StaticResource PageTitle}"
                           FontSize="30"
                           Text="WWPTools" />
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource PageSubtitle}"
                           Text="WW+P Revit productivity tools and automation workflows." />

                <WrapPanel Margin="0,14,0,0">
                    <Border Style="{StaticResource AboutBadge}">
                        <TextBlock x:Name="VersionText" FontSize="12" FontWeight="SemiBold" Text="Version v1.3.3" />
                    </Border>
                    <Border x:Name="BranchBadge" Style="{StaticResource AboutBadge}" Visibility="Collapsed">
                        <TextBlock x:Name="BranchText" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Branch main" />
                    </Border>
                    <Border x:Name="CommitBadge" Style="{StaticResource AboutBadge}" Visibility="Collapsed">
                        <TextBlock x:Name="CommitText" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="Commit abc1234" />
                    </Border>
                </WrapPanel>

                <TextBlock x:Name="BodyText"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Text="Use this panel to quickly open WWP resources, release notes, and the GitHub repository." />

                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="WebsiteButton" Content="Website" Margin="0,0,8,8" />
                    <Button x:Name="GuidebookButton" Content="Guidebook" Margin="0,0,8,8" />
                    <Button x:Name="GithubButton" Content="GitHub" Margin="0,0,8,8" />
                    <Button x:Name="ReleaseButton" Content="Release Notes" Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock x:Name="FooterText"
                           Margin="0,12,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="Click anywhere outside the panel or press Esc to close." />

                <CheckBox x:Name="TelemetryCheckBox"
                          Margin="0,10,0,0"
                          FontSize="12"
                          Foreground="{StaticResource MutedBrush}"
                          IsChecked="True"
                          Checked="on_telemetry_changed"
                          Unchecked="on_telemetry_changed"
                          Content="Send anonymous usage reports to help improve WWPTools" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
